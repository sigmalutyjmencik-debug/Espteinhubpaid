function RenderWhitelist()
    for _,c in ipairs(whitelistFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1,-6,0,22)
            b.BackgroundColor3 = whitelist[p.Name] and Color3.fromRGB(120,30,120) or Color3.fromRGB(20,20,20)
            b.BorderSizePixel = 0
            b.Text = p.Name .. (whitelist[p.Name] and "  ON" or "")
            b.TextColor3 = WHITE
            b.Font = Enum.Font.Code
            b.TextSize = 11
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.AutoButtonColor = false
            b.Parent = whitelistFrame
            Instance.new("UIPadding",b).PaddingLeft = UDim.new(0,6)
            b.MouseButton1Click:Connect(function()
                whitelist[p.Name] = not whitelist[p.Name] or nil
                RenderWhitelist()
            end)
        end
    end
end

Players.PlayerAdded:Connect(RenderWhitelist)
Players.PlayerRemoving:Connect(RenderWhitelist)
RenderWhitelist()

local function SelectTab(index)
    for i,page in ipairs(Pages) do
        page.Visible = (i == index)
    end
    for i,btn in ipairs(TabButtons) do
        btn.TextColor3 = i == index and WHITE or GRAY
    end
    Picker.Visible = false
end

for i,btn in ipairs(TabButtons) do
    btn.MouseButton1Click:Connect(function() SelectTab(i) end)
end
SelectTab(1)

