end

-- KEYBINDS
UIS.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == airWalkKey then DoAirWalk() end
    if inp.KeyCode == tpKey then DoTeleport() end
end)

-- INIT
SetBorderColor(Color3.fromRGB(255,25,25))
SetAccentColor(Color3.fromRGB(255,25,25))
LoadColor(ACCENT_COLOR)

task.defer(function() CenterMain() end)
