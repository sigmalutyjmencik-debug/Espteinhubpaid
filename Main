local tpBtn = Instance.new("TextButton")
tpBtn.Position = UDim2.fromOffset(10,mY)
tpBtn.Size = UDim2.new(1,-20,0,28)
tpBtn.BackgroundColor3 = ACCENT_COLOR
tpBtn.BorderSizePixel = 0
tpBtn.Text = "Teleport To Nearest Player"
tpBtn.TextColor3 = WHITE
tpBtn.Font = Enum.Font.Code
tpBtn.TextSize = 13
tpBtn.AutoButtonColor = false
tpBtn.Parent = MiscScroll
Stroke(tpBtn,1)
RegisterAccent(tpBtn,"BackgroundColor3")
tpBtn.MouseButton1Click:Connect(function()
    local closest, dist = nil, math.huge
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local d = (r.Position - myRoot.Position).Magnitude
                if d < dist then dist = d; closest = r end
            end
        end
    end
    if closest then
        myRoot.CFrame = closest.CFrame + Vector3.new(0,3,0)
    end
end)
mY = mY + 32

