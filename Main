-- Безопасное получение контейнера для GUI
local GUI_PARENT = (function()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    if syn and syn.protect_gui then
        local sg = Instance.new("ScreenGui")
        local ok = pcall(function() syn.protect_gui(sg) end)
        if ok then
            sg.Parent = game:GetService("CoreGui")
            return sg.Parent
        end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return LP:WaitForChild("PlayerGui")
end)()

-- Уборка старых
for _, n in ipairs({"NyxonProject","ProjectAstra","AstraFOV","AstraFreezeUI","AstraTPButton","AstraAirWalkButton","EpsteinHub","EpsteinMobile","EpsteinStats"}) do
    pcall(function()
        local p1 = GUI_PARENT:FindFirstChild(n)
        if p1 then p1:Destroy() end
        local p2 = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild(n)
        if p2 then p2:Destroy() end
        local p3 = game:GetService("CoreGui"):FindFirstChild(n)
        if p3 then p3:Destroy() end
    end)
end

