loadBtn.BackgroundColor3 = ACCENT_COLOR
loadBtn.BorderSizePixel = 0
loadBtn.Text = "Load Config (JSON)"
loadBtn.TextColor3 = WHITE
loadBtn.Font = Enum.Font.Code
loadBtn.TextSize = 13
loadBtn.AutoButtonColor = false
loadBtn.Parent = SetScroll
Stroke(loadBtn,1)
RegisterAccent(loadBtn,"BackgroundColor3")
loadBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if isfile and isfile(cfgPath) then
            local cfg = HttpService:JSONDecode(readfile(cfgPath))
