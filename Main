local TabNames = { "Combat", "Visuals", "Misc", "Settings" }
local TabButtons = {}

for i,name in ipairs(TabNames) do
    local b = Instance.new("TextButton")
    b.Position = UDim2.new((i-1)*0.25,0,0,0)
    b.Size = UDim2.new(0.25,0,1,0)
    b.BackgroundTransparency = 1
    b.BorderSizePixel = 0
    b.Text = name
    b.TextColor3 = i==1 and WHITE or GRAY
    b.Font = Enum.Font.Code
    b.TextSize = 14
    b.AutoButtonColor = false
    b.Parent = Tabs
    TabButtons[i] = b
end
Line(Main,82)

local Pages = {}
local Scrolls = {}

for i,name in ipairs(TabNames) do
    local page = Instance.new("Frame")
    page.Name = name
    page.Position = UDim2.fromOffset(0,83)
    page.Size = UDim2.new(1,0,1,-83)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.Visible = (i==1)
    page.Parent = Main

    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = "Scroll"
    scroll.Size = UDim2.fromScale(1,1)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = ACCENT_COLOR
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new()
    scroll.Parent = page

    local layout = Instance.new("UIListLayout",scroll)
    layout.Padding = UDim.new(0,4)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local pad = Instance.new("UIPadding",scroll)
    pad.PaddingTop = UDim.new(0,8)
    pad.PaddingLeft = UDim.new(0,8)
    pad.PaddingRight = UDim.new(0,8)
    pad.PaddingBottom = UDim.new(0,8)

    Pages[i] = page
    Scrolls[i] = scroll
end

local function section(parent, title, y)
    local f = Instance.new("Frame")
    f.Position = UDim2.fromOffset(0,y)
    f.Size = UDim2.new(1,0,0,24)
    f.BackgroundColor3 = PANEL
    f.BorderSizePixel = 0
    f.Parent = parent
    Stroke(f,1)
    Text(f,title,UDim2.fromOffset(8,0),UDim2.new(1,-16,1,0),13,ACCENT_COLOR)
    return 26
end

