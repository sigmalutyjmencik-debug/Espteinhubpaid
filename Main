-- LOGIC: FOV, SNAPLINE, ESP, MOVEMENT
do
    local A = _G.A
    local RS = A.RS
    local UIS = A.UIS
    local LP = A.LP
    local Camera = A.Camera
    local Players = A.Players
    local Lighting = A.Lighting
    local Debris = A.Debris
    local SoundService = A.SoundService
    local GUI_PARENT = A.GUI_PARENT

    -- FOV Circle
    local FOVFrameGui = Instance.new("ScreenGui")
    FOVFrameGui.Name = "AstraFOV"
    FOVFrameGui.ResetOnSpawn = false
    FOVFrameGui.IgnoreGuiInset = true
    pcall(function() FOVFrameGui.Parent = GUI_PARENT end)
    if not FOVFrameGui.Parent then FOVFrameGui.Parent = LP:WaitForChild("PlayerGui") end

    local FOVFrame = Instance.new("Frame")
    FOVFrame.BackgroundTransparency = 1
    FOVFrame.BorderSizePixel = 0
    FOVFrame.Visible = false
    FOVFrame.ZIndex = 999
    FOVFrame.Parent = FOVFrameGui
    local FOVStroke = Instance.new("UIStroke", FOVFrame)
    FOVStroke.Thickness = 1.5
    FOVStroke.Transparency = 0.3
    local FOVCorner = Instance.new("UICorner", FOVFrame)
    FOVCorner.CornerRadius = UDim.new(1,0)

    local snapLine = nil
    if Drawing then
        snapLine = Drawing.new("Line")
        snapLine.Visible = false
        snapLine.Thickness = 2
        snapLine.Transparency = 0.8
        snapLine.Color = A.silentAimSnaplineColor
    end

    local function getSilentTarget()
        local best, bd = nil, A.FOV_RADIUS
        local vp = Camera.ViewportSize
        local center = Vector2.new(vp.X/2, vp.Y/2)
        for _,p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if A.TEAM_CHECK and p.Team == LP.Team then continue end
            if A.whitelistEnabled and A.whitelistPlayers[p.Name] then continue end
            local char = p.Character
            if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local partName = A.HIT_PART
            if partName == "Random" then
                local opts = {"Head","Torso","HumanoidRootPart"}
                partName = opts[math.random(1,#opts)]
            end
            local part = char:FindFirstChild(partName) or char:FindFirstChild("Head")
            if not part then continue end
            local pos, onS = Camera:WorldToViewportPoint(part.Position)
            if not onS then continue end
            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if dist < bd then bd = dist best = part end
        end
        return best
    end
    A.getSilentTarget = getSilentTarget

    -- Hitmarkers
    local function CreateHitmarker(worldPosition)
        if not A.hitMarkerEnabled then return end
        if not Drawing then return end
        local markerId = tostring(math.random(1,100000))
        local markerData = {
            WorldPosition = worldPosition,
            Size = A.hitMarkerSize,
            Gap = A.hitMarkerGap,
            Opacity = 1,
            Lines = {}
        }
        for i = 1,4 do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Color = A.hitMarkerColor
            line.Thickness = 2.5
            table.insert(markerData.Lines, line)
        end
        A.ActiveHitmarkers[markerId] = markerData
        task.spawn(function()
            local duration = math.max(0.05, A.hitMarkerDuration)
            local totalSteps = 20
            local stepTime = duration / totalSteps
            for i = totalSteps, 0, -1 do
                if not A.ActiveHitmarkers[markerId] then return end
                markerData.Opacity = i / totalSteps
                task.wait(stepTime)
            end
            for _,line in ipairs(markerData.Lines) do pcall(function() line:Remove() end) end
            A.ActiveHitmarkers[markerId] = nil
        end)
    end
    A.CreateHitmarker = CreateHitmarker

    -- Tracer
    local function CreateTracer(from, to)
        if not A.TRACER then return end
        if (to - from).Magnitude < 1 then return end
        local holder = Instance.new("Part")
        holder.Size = Vector3.new(0.05,0.05,0.05)
        holder.Transparency = 1
        holder.Anchored = true
        holder.CanCollide = false
        holder.Position = from
        holder.Parent = workspace
        local a0 = Instance.new("Attachment", holder)
        a0.WorldPosition = from
        local a1 = Instance.new("Attachment", holder)
        a1.WorldPosition = to
        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.FaceCamera = true
        beam.LightEmission = 1
        if A.TRACER_TYPE == "Red Laser" then
            beam.Width0 = 1.2 beam.Width1 = 1.2
            beam.Color = ColorSequence.new(Color3.fromRGB(255,10,10))
        else
            beam.Width0 = 0.4 beam.Width1 = 0.4
            beam.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150,50,220)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
            })
        end
        beam.Parent = holder
        Debris:AddItem(holder, A.TRACER_LIFE)
    end
    A.CreateTracer = CreateTracer

    -- ESP
    local function createESP(player)
        if A.espCache[player] then return end
        if not Drawing then return end
        local o = {
            Box = Drawing.new("Square"),
            Name = Drawing.new("Text"),
            HPBar = Drawing.new("Square"),
            HPBg = Drawing.new("Square"),
            Dist = Drawing.new("Text"),
            Weapon = Drawing.new("Text"),
        }
        o.Box.Filled = false o.Box.Thickness = 1.5
        o.Name.Size = 14 o.Name.Center = true o.Name.Outline = true
        o.HPBg.Filled = true o.HPBg.Color = Color3.fromRGB(40,40,40)
        o.HPBar.Filled = true
        o.Dist.Size = 12 o.Dist.Center = true o.Dist.Outline = true
        o.Weapon.Size = 12 o.Weapon.Center = true o.Weapon.Outline = true
        for _,d in pairs(o) do d.Visible = false end
        A.espCache[player] = o
    end

    local function removeESP(player)
        if A.espCache[player] then
            for _,d in pairs(A.espCache[player]) do pcall(function() d:Remove() end) end
            A.espCache[player] = nil
        end
    end

    Players.PlayerAdded:Connect(function(p) if p ~= LP then createESP(p) end end)
    Players.PlayerRemoving:Connect(removeESP)
    for _,p in ipairs(Players:GetPlayers()) do if p ~= LP then createESP(p) end end

    -- Skybox
    function A.ApplySkybox(name)
        if A.activeSky then A.activeSky:Destroy() A.activeSky = nil end
        if name == "None" then return end
        for _,o in ipairs(Lighting:GetChildren()) do
            if o:IsA("Sky") or o:IsA("Atmosphere") then o:Destroy() end
        end
        local s = Instance.new("Sky")
        if name == "Galaxy" then
            s.SkyboxFt = "rbxassetid://99674108178510"
            s.SkyboxBk = "rbxassetid://76898653037615"
            s.SkyboxLf = "rbxassetid://78775818685659"
            s.SkyboxRt = "rbxassetid://117864739442861"
            s.SkyboxUp = "rbxassetid://94326041205929"
            s.SkyboxDn = "rbxassetid://134726625576772"
        else
            local id = A.SKYBOXES[name]
            if id and id ~= "MULTI" then
                s.SkyboxBk = id s.SkyboxDn = id s.SkyboxFt = id
                s.SkyboxLf = id s.SkyboxRt = id s.SkyboxUp = id
            end
        end
        s.Parent = Lighting
        A.activeSky = s
    end

    -- Custom Hands
    local TARGET_ARM_NAMES = {["RightArm"]=true,["LeftArm"]=true,["SleeveL"]=true,["SleeveR"]=true}

    local function BindArm(part)
        if A.activeLockedArms[part] then return end
        A.activeLockedArms[part] = true
        part.Color = A.customHandsColor
        part.Transparency = A.customHandsTransp
        part.Material = Enum.Material.Neon
    end

    function A.SetupCustomHands()
        for _,obj in ipairs(game:GetDescendants()) do
            if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then BindArm(obj) end
        end
    end

    -- ViewModel
    function A.ApplyViewModel()
        if A.viewModelConn then A.viewModelConn:Disconnect() A.viewModelConn = nil end
        if not A.viewModelEnabled then return end
        A.viewModelConn = RS.RenderStepped:Connect(function()
            if not A.viewModelEnabled then return end
            local char = LP.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end
            local toolWorld = workspace:FindFirstChild(tool.Name)
            if not toolWorld then return end
            pcall(function()
                toolWorld:PivotTo(Camera.CFrame * CFrame.new(A.viewModelX, A.viewModelY, A.viewModelZ))
            end)
        end)
    end

    function A.RemoveViewModel()
        if A.viewModelConn then A.viewModelConn:Disconnect() A.viewModelConn = nil end
    end

    -- Teleport / AirWalk
    function A.DoTeleport()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        root.CFrame = CFrame.new(root.Position + Camera.CFrame.LookVector * A.tpDistance) * root.CFrame.Rotation
        root.Velocity = Vector3.zero
    end

    function A.DoAirWalk()
        if A.airWalkBusy then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        A.airWalkBusy = true
        local targetY = root.Position.Y + A.airWalkHeight
        root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z) * root.CFrame.Rotation
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(0, math.huge, 0)
        bp.Position = Vector3.new(0, targetY, 0)
        bp.P = 25000
        bp.Parent = root
        hum:ChangeState(Enum.HumanoidStateType.Running)
        task.wait(A.airWalkDuration)
        if bp then bp:Destroy() end
        root.Velocity = Vector3.zero
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        A.airWalkBusy = false
    end

    -- TP Button
    function A.CreateTPButton()
        if A.tpBtnGui then return end
        local g = Instance.new("ScreenGui")
        g.Name = "AstraTPButton" g.ResetOnSpawn = false
        pcall(function() g.Parent = GUI_PARENT end)
        if not g.Parent then g.Parent = LP:WaitForChild("PlayerGui") end
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0,110,0,45)
        btn.Position = UDim2.new(0.1,0,0.5,0)
        btn.BackgroundColor3 = Color3.fromRGB(25,30,40)
        btn.Text = "TP Studs"
        btn.TextColor3 = Color3.fromRGB(240,240,240)
        btn.Font = Enum.Font.Code btn.TextSize = 14
        btn.ZIndex = 99999 btn.Parent = g
        Instance.new("UICorner",btn).CornerRadius = UDim.new(0,5)
        btn.MouseButton1Click:Connect(function() A.DoTeleport() end)
        A.tpBtnGui = g
    end
    function A.DestroyTPButton()
        if A.tpBtnGui then A.tpBtnGui:Destroy() A.tpBtnGui = nil end
    end

    -- RENDER LOOP
    RS.RenderStepped:Connect(function()
        local vp = Camera.ViewportSize
        local cx = vp.X/2
        local cy = vp.Y/2

        FOVFrame.Position = UDim2.fromOffset(cx - A.FOV_RADIUS, cy - A.FOV_RADIUS)
        FOVFrame.Size = UDim2.fromOffset(A.FOV_RADIUS*2, A.FOV_RADIUS*2)
        FOVFrame.Visible = A.SHOW_FOV and A.SILENT_AIM
        FOVStroke.Color = A.silentAimFovColor

        if snapLine then
            if not A.SILENT_AIM or not A.SNAPLINE then
                snapLine.Visible = false
            else
                local t = getSilentTarget()
                if not t then snapLine.Visible = false
                else
                    local pos, onS = Camera:WorldToViewportPoint(t.Position)
                    if not onS then snapLine.Visible = false
                    else
                        snapLine.From = Vector2.new(cx, cy)
                        snapLine.To = Vector2.new(pos.X, pos.Y)
                        snapLine.Color = A.silentAimSnaplineColor
                        snapLine.Visible = true
                    end
                end
            end
        end

        -- Hitmarkers
        for id, marker in pairs(A.ActiveHitmarkers) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(marker.WorldPosition)
            if onScreen and marker.Opacity > 0 then
                local x,y = screenPos.X, screenPos.Y
                local sz = marker.Size
                local gap = marker.Gap
                marker.Lines[1].From = Vector2.new(x-gap, y-gap)
                marker.Lines[1].To = Vector2.new(x-gap-sz, y-gap-sz)
                marker.Lines[2].From = Vector2.new(x+gap, y-gap)
                marker.Lines[2].To = Vector2.new(x+gap+sz, y-gap-sz)
                marker.Lines[3].From = Vector2.new(x-gap, y+gap)
                marker.Lines[3].To = Vector2.new(x-gap-sz, y+gap+sz)
                marker.Lines[4].From = Vector2.new(x+gap, y+gap)
                marker.Lines[4].To = Vector2.new(x+gap+sz, y+gap+sz)
                for _,line in ipairs(marker.Lines) do
                    line.Transparency = marker.Opacity
                    line.Visible = true
                end
            else
                for _,line in ipairs(marker.Lines) do line.Visible = false end
            end
        end

        -- ESP
        for player, o in pairs(A.espCache) do
            local char = player.Character
            if A.espEnabled and char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and head and hum and hum.Health > 0 then
                    local headPos, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    local legPos, on2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
                    if on1 and on2 then
                        local boxH = math.abs(headPos.Y - legPos.Y)
                        local boxW = boxH / 1.6
                        local bx = headPos.X - boxW/2
                        local by = headPos.Y
                        if A.espBox then
                            o.Box.Size = Vector2.new(boxW, boxH)
                            o.Box.Position = Vector2.new(bx, by)
                            o.Box.Color = A.espBoxColor
                            o.Box.Visible = true
                        else o.Box.Visible = false end
                        if A.espName then
                            o.Name.Text = player.Name
                            o.Name.Position = Vector2.new(headPos.X, by-16)
                            o.Name.Color = A.espNameColor
                            o.Name.Visible = true
                        else o.Name.Visible = false end
                        if A.espHealth then
                            local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                            local barH = boxH * hp
                            o.HPBg.Size = Vector2.new(4, boxH)
                            o.HPBg.Position = Vector2.new(bx-6, by)
                            o.HPBg.Visible = true
                            o.HPBar.Size = Vector2.new(4, barH)
                            o.HPBar.Position = Vector2.new(bx-6, by+(boxH-barH))
                            o.HPBar.Color = Color3.fromHSV(hp*0.33, 1, 1)
                            o.HPBar.Visible = true
                        else o.HPBg.Visible = false o.HPBar.Visible = false end
                        if A.espDistance then
                            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                            local d = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                            o.Dist.Text = d.." studs"
                            o.Dist.Position = Vector2.new(headPos.X, legPos.Y+4)
                            o.Dist.Color = A.espDistColor
                            o.Dist.Visible = true
                        else o.Dist.Visible = false end
                        if A.espWeapon then
                            local tool = char:FindFirstChildOfClass("Tool")
                            o.Weapon.Text = tool and tool.Name or "Fists"
                            o.Weapon.Position = Vector2.new(headPos.X, legPos.Y+18)
                            o.Weapon.Color = A.espWeapColor
                            o.Weapon.Visible = true
                        else o.Weapon.Visible = false end
                    else
                        for _,d in pairs(o) do d.Visible = false end
                    end
                else
                    for _,d in pairs(o) do d.Visible = false end
                end
            else
                for _,d in pairs(o) do d.Visible = false end
            end
        end

        if A.cameraFovEnabled then
            local cam = workspace.CurrentCamera
            if cam and cam.FieldOfView ~= A.cameraFovValue then
                cam.FieldOfView = A.cameraFovValue
            end
        end
    end)

    -- HEARTBEAT
    local wasInAirBhop = false
    RS.Heartbeat:Connect(function()
        if A.noFogEnabled and Lighting.FogEnd ~= 1e6 then
            Lighting.FogEnd = 1e6 Lighting.FogStart = 1e5
        end
        if A.fullbrightEnabled then
            if Lighting.Brightness ~= 3 then Lighting.Brightness = 3 end
            if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
            if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
        end

        local char = LP.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        if A.noClipEnabled then
            for _,p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
        if A.speedHackEnabled and hum.WalkSpeed ~= A.speedValue then
            hum.WalkSpeed = A.speedValue
        end
        if A.flyEnabled then
            local UIS = A.UIS
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
            root.Velocity = dir.Magnitude > 0 and dir.Unit * A.flySpeed or Vector3.zero
            hum.PlatformStand = true
        elseif hum.PlatformStand and not A.freezeEnabled and not A.airWalkBusy then
            hum.PlatformStand = false
        end
        if A.freezeEnabled and A.UIS:IsKeyDown(A.keybinds.Freeze) then
            if not A.freezeTargetCF then
                A.freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
            end
            root.CFrame = A.freezeTargetCF
            root.Velocity = Vector3.zero
            hum.PlatformStand = true
        elseif A.freezeTargetCF then
            A.freezeTargetCF = nil
            hum.PlatformStand = false
        end
        if A.bhopEnabled then
            local state = hum:GetState()
            local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
            if not inAir and wasInAirBhop then hum.Jump = true end
            wasInAirBhop = inAir
        end
        if A.gunChamsEnabled then
            for _,tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    for _,p in ipairs(tool:GetDescendants()) do
                        if p:IsA("BasePart") then
                            p.Color = A.gunChamsColor
                            p.Material = Enum.Material.Neon
                        end
                    end
                end
            end
        end
    end)

    -- INPUT
    UIS.JumpRequest:Connect(function()
        local char = LP.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and A.infJumpEnabled then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)

    UIS.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == A.airWalkKey then A.DoAirWalk() end
        if inp.KeyCode == A.tpKey then A.DoTeleport() end
    end)

    print("[Astra] Logic initialized")
end

-- WEAPON HOOKS
do
    local A = _G.A
    local RS = A.RS
    local LP = A.LP
    local ReplicatedStorage = A.ReplicatedStorage
    local SoundService = A.SoundService

    task.spawn(function()
        task.wait(2)
        pcall(function()
            local blaster = ReplicatedStorage:FindFirstChild("Blaster")
            if not blaster then return end

            -- castRays hook
            local util = blaster:FindFirstChild("Utility")
            local castRaysFunc = nil
            if util then
                local cr = util:FindFirstChild("castRays")
                if cr then
                    local ok, f = pcall(require, cr)
                    if ok and type(f) == "function" then castRaysFunc = f end
                end
            end
            if castRaysFunc and type(hookfunction) == "function" then
                pcall(function()
                    local original
                    original = hookfunction(castRaysFunc, function(plr, origin, dirs, ...)
                        if plr ~= LP then return original(plr, origin, dirs, ...) end
                        local target = nil
                        if A.SILENT_AIM and A.getSilentTarget then target = A.getSilentTarget() end
                        if target and type(dirs) == "table" then
                            for k in pairs(dirs) do dirs[k] = Vector3.new(0,0,-1) end
                        end
                        local result = original(plr, origin, dirs, ...)
                        if not target then return result end
                        if A.TRACER and A.CreateTracer then
                            pcall(function() A.CreateTracer(origin, target.Position) end)
                        end
                        if A.HIT_CHANCE/100 > math.random() then
                            if type(result) == "table" then
                                if result.position then
                                    result.position = target.Position
                                    result.instance = target
                                    if target.Parent then
                                        result.taggedHumanoid = target.Parent:FindFirstChildOfClass("Humanoid")
                                    end
                                end
                            end
                            if A.CreateHitmarker then pcall(function() A.CreateHitmarker(target.Position) end) end
                            if A.HIT_SOUND then
                                task.spawn(function()
                                    local s = Instance.new("Sound")
                                    s.SoundId = "rbxassetid://"..A.HIT_SOUND_ID
                                    s.Volume = A.HIT_SOUND_VOL
                                    s.Parent = SoundService
                                    s:Play()
                                    task.wait(2)
                                    s:Destroy()
                                end)
                            end
                            return result
                        end
                        return result
                    end)
                end)
            end

            -- BlasterController
            local scripts = blaster:FindFirstChild("Scripts")
            if not scripts then return end

            pcall(function()
                local getRD = util and util:FindFirstChild("getRayDirections")
                if getRD then
                    local original = require(getRD)
                    package.loaded[getRD] = function(cf, count, spread, seed)
                        if A.noSpreadEnabled or A.SILENT_AIM then
                            local dirs = table.create(count)
                            local dir = cf.LookVector
                            for i=1,count do dirs[i] = dir end
                            return dirs
                        end
                        return original(cf, count, spread, seed)
                    end
                end
            end)

            local okBc, BC = pcall(function()
                return require(scripts:FindFirstChild("BlasterController"))
            end)
            if not okBc or not BC then return end

            pcall(function()
                local recoiler = scripts:FindFirstChild("CameraRecoiler")
                if recoiler then
                    local CR = require(recoiler)
                    local oldRecoil = CR.recoil
                    CR.recoil = function(...)
                        if A.noRecoilEnabled then return end
                        return oldRecoil(...)
                    end
                end
            end)

            if BC.reload then
                local oldReload = BC.reload
                BC.reload = function(self)
                    if not (A.instantReloadEnabled or A.autoReloadEnabled) then return oldReload(self) end
                    if tick() - A.lastReloadTime < 0.15 then return end
                    A.lastReloadTime = tick()
                    local maxAmmo = self.blaster and self.blaster:GetAttribute("magazineSize") or 30
                    self.ammo = maxAmmo
                    self.reloading = false
                    pcall(function()
                        if self.guiController then
                            self.guiController:setAmmo(maxAmmo)
                            self.guiController:setReloading(false)
                        end
                    end)
                    pcall(function()
                        local remotes = blaster:FindFirstChild("Remotes")
                        local reloadRemote = remotes and remotes:FindFirstChild("Reload")
                        if reloadRemote then reloadRemote:FireServer(self.blaster) end
                    end)
                end
            end

            if BC.canShoot then
                local oldCanShoot = BC.canShoot
                BC.canShoot = function(self)
                    if A.noEquipDelayEnabled then
                        self.canShootAfterEquip = true
                        self.isWeaponBlocked = false
                    end
                    if (A.instantReloadEnabled or A.autoReloadEnabled) and self.ammo ~= nil and self.ammo <= 0 then
                        pcall(function() BC.reload(self) end)
                    end
                    if A.noEquipDelayEnabled or A.instantReloadEnabled or A.autoReloadEnabled then
                        local sc = _G.SprintController
                        local sprinting = sc and sc.isSprinting and sc.isSprinting()
                        local hasAmmo = (self.ammo and self.ammo > 0) or A.instantReloadEnabled or A.autoReloadEnabled
                        return self:isHumanoidAlive() and self.equipped and hasAmmo and not sprinting
                    end
                    return oldCanShoot(self)
                end
            end

            if BC.startShooting then
                local oldSS = BC.startShooting
                BC.startShooting = function(self)
                    if A.fullAutoEnabled then
                        pcall(function()
                            if self.blaster then self.blaster:SetAttribute("fireMode","Auto") end
                        end)
                    end
                    return oldSS(self)
                end
            end

            if BC.equip then
                local oldEquip = BC.equip
                BC.equip = function(self)
                    oldEquip(self)
                    if A.noEquipDelayEnabled then self.canShootAfterEquip = true end
                end
            end
        end)
    end)

    -- Rapid fire
    local function processToolForRapidFire(tool)
        if not A.RAPID_FIRE then return end
        if not tool or not tool:IsA("Tool") then return end
        for attrName, _ in pairs(tool:GetAttributes()) do
            if attrName:lower() == "rateoffire" then
                pcall(function() tool:SetAttribute(attrName, A.RAPID_VALUE) end)
            end
        end
    end

    local function hookCharForRapid(char)
        if not char then return end
        for _,item in ipairs(char:GetChildren()) do processToolForRapidFire(item) end
        char.ChildAdded:Connect(function(child)
            task.wait(0.05)
            processToolForRapidFire(child)
        end)
    end

    if LP.Character then hookCharForRapid(LP.Character) end
    LP.CharacterAdded:Connect(hookCharForRapid)

    task.spawn(function()
        while true do
            task.wait(0.5)
            if A.RAPID_FIRE and LP.Character then
                for _,item in ipairs(LP.Character:GetChildren()) do
                    processToolForRapidFire(item)
                end
            end
        end
    end)

    -- Instant hit bullet speed
    task.spawn(function()
        while true do
            task.wait(0.1)
            if A.instantHitEnabled then
                local char = LP.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        pcall(function()
                            for name, _ in pairs(tool:GetAttributes()) do
                                local lower = name:lower()
                                if lower == "bulletspeed" or lower == "bulletvelocity" or lower == "projectilespeed" then
                                    tool:SetAttribute(name, A.bulletSpeedValue)
                                end
                            end
                        end)
                    end
                end
            end
        end
    end)

    print("[Astra] Weapon hooks initialized")
end

task.defer(function()
    if _G.A and _G.A.CenterMain then
        _G.A.CenterMain()
    end
end)

print("[Astra v19] LOADED OK")
