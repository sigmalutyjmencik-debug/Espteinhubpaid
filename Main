local GUI_PARENT
do
    local found = false
    if type(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and h then
            GUI_PARENT = h
            found = true
        end
    end
    if not found then
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok and cg then
            GUI_PARENT = cg
        else
            GUI_PARENT = LP:WaitForChild("PlayerGui")
        end
    end
end

do
    local names = {"ProjectAstra","AstraFOV","AstraFreezeUI","AstraTPButton","AstraAirWalkButton"}
    for i = 1, #names do
        pcall(function()
            local a = GUI_PARENT:FindFirstChild(names[i])
            if a then a:Destroy() end
            local pg = LP:FindFirstChild("PlayerGui")
            if pg then
                local b = pg:FindFirstChild(names[i])
                if b then b:Destroy() end
            end
        end)
    end
end

