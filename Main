local function CenterMain()
    local vp = Camera.ViewportSize
    local scale = MainScale.Scale
    local w = Main.Size.X.Offset * scale
    local h = Main.Size.Y.Offset * scale
    Main.Position = UDim2.fromOffset((vp.X-w)/2,(vp.Y-h)/2)
end
CenterMain()

