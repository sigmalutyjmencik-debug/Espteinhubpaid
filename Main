    if tpBtnGui then return end
    tpBtnGui = Instance.new("ScreenGui")
    tpBtnGui.Name = "AstraTPButton"
    tpBtnGui.ResetOnSpawn = false
    pcall(function() tpBtnGui.Parent = GUI_PARENT end)
    if not tpBtnGui.Parent then tpBtnGui.Parent = LP:WaitForChild("PlayerGui") end

    tpBtn = Instance.new("TextButton")
