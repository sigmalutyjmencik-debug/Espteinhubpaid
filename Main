--========================================================--
-- COLOR REGISTRY
--========================================================--

local BorderRegistry = {}
local AccentRegistry = {}

local function RegisterBorder(obj, property)
    table.insert(BorderRegistry,{object=obj, property=property or "Color"})
end

local function RegisterAccent(obj, property)
    table.insert(AccentRegistry,{object=obj, property=property or "BackgroundColor3"})
end

local function SetBorderColor(color)
    BORDER_COLOR = color
    for i = #BorderRegistry,1,-1 do
        local it = BorderRegistry[i]
        if it.object and it.object.Parent then
            pcall(function() it.object[it.property] = color end)
        else table.remove(BorderRegistry,i) end
    end
end

local function SetAccentColor(color)
    ACCENT_COLOR = color
    for i = #AccentRegistry,1,-1 do
        local it = AccentRegistry[i]
        if it.object and it.object.Parent then
            pcall(function() it.object[it.property] = color end)
        else table.remove(AccentRegistry,i) end
    end
end

--========================================================--
-- HELPERS
--========================================================--

local function Stroke(parent, thickness)
    local s = Instance.new("UIStroke")
    s.Color = BORDER_COLOR
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    RegisterBorder(s,"Color")
    return s
end

local function Text(parent, value, position, size, textSize, color)
    local l = Instance.new("TextLabel")
    l.Position = position
    l.Size = size
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Text = value
    l.TextColor3 = color or WHITE
    l.Font = Enum.Font.Code
    l.TextSize = textSize or 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent
    return l
end

local function Line(parent, y)
    local l = Instance.new("Frame")
    l.Position = UDim2.new(0,0,0,y)
    l.Size = UDim2.new(1,0,0,1)
    l.BackgroundColor3 = ACCENT_COLOR
    l.BorderSizePixel = 0
    l.Parent = parent
    RegisterAccent(l,"BackgroundColor3")
    return l
end

