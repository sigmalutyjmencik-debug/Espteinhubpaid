-- UI HELPERS
do
    local A = _G.A
    local GUI_PARENT = A.GUI_PARENT
    local WHITE = A.WHITE
    local GRAY = A.GRAY
    local ACCENT = A.ACCENT
    local BG = A.BG
    local PANEL = A.PANEL
    local DROPBG = A.DROPBG
    local BARBG = A.BARBG
    local CHECKBG = A.CHECKBG
    local UIS = A.UIS

    local function Stroke(parent, thickness)
        local s = Instance.new("UIStroke")
        s.Color = ACCENT
        s.Thickness = thickness or 1
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = parent
        return s
    end

    local function MakeText(parent, value, pos, size, ts, col)
        local l = Instance.new("TextLabel")
        l.Position = pos
        l.Size = size
        l.BackgroundTransparency = 1
        l.BorderSizePixel = 0
        l.Text = value
        l.TextColor3 = col or WHITE
        l.Font = Enum.Font.Code
        l.TextSize = ts or 13
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextYAlignment = Enum.TextYAlignment.Center
        l.Parent = parent
        return l
    end

    local function Checkbox(parent, label, default, callback)
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1,0,0,24)
        container.BackgroundTransparency = 1
        container.Parent = parent

        local box = Instance.new("TextButton")
        box.Size = UDim2.fromOffset(18,18)
        box.Position = UDim2.fromOffset(0,3)
        box.BackgroundColor3 = CHECKBG
        box.BorderSizePixel = 0
        box.Text = ""
        box.AutoButtonColor = false
        box.Parent = container
        Stroke(box,1)

        local fill = Instance.new("Frame")
        fill.Position = UDim2.fromOffset(3,3)
        fill.Size = UDim2.fromOffset(12,12)
        fill.BackgroundColor3 = ACCENT
        fill.BorderSizePixel = 0
        fill.Visible = default and true or false
        fill.Parent = box

        MakeText(container, label, UDim2.fromOffset(26,0), UDim2.new(1,-26,1,0), 13, WHITE)

        local state = default
        box.MouseButton1Click:Connect(function()
            state = not state
            fill.Visible = state
            if callback then pcall(callback, state) end
        end)
        return container
    end

    local function Slider(parent, label, minV, maxV, default, callback, suffix)
        suffix = suffix or ""
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1,0,0,44)
        container.BackgroundTransparency = 1
        container.Parent = parent

        MakeText(container, label, UDim2.fromOffset(0,0), UDim2.new(1,-60,0,18), 12, WHITE)
        local valLabel = MakeText(container, tostring(default)..suffix, UDim2.new(1,-60,0,0), UDim2.fromOffset(60,18), 12, ACCENT)
        valLabel.TextXAlignment = Enum.TextXAlignment.Right

        local bar = Instance.new("Frame")
        bar.Position = UDim2.fromOffset(0,22)
        bar.Size = UDim2.new(1,0,0,18)
        bar.BackgroundColor3 = BARBG
        bar.BorderSizePixel = 0
        bar.Parent = container
        Stroke(bar,1)

        local ratio = maxV > minV and (default - minV)/(maxV - minV) or 0
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(ratio,0,1,0)
        fill.BackgroundColor3 = ACCENT
        fill.BorderSizePixel = 0
        fill.Parent = bar

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromScale(1,1)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.ZIndex = 5
        btn.Parent = bar

        local draggingSlider = false
        local function update(input)
            local sizeX = bar.AbsoluteSize.X
            if sizeX <= 0 then return end
            local x = input.Position.X - bar.AbsolutePosition.X
            local r = math.clamp(x/sizeX, 0, 1)
            fill.Size = UDim2.new(r,0,1,0)
            local v = math.floor(minV + (maxV-minV)*r + 0.5)
            valLabel.Text = tostring(v)..suffix
            if callback then pcall(callback, v) end
        end

        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
                update(i)
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if draggingSlider and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                update(i)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)
        return container
    end

    local function Dropdown(parent, label, options, default, callback)
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1,0,0,52)
        container.BackgroundTransparency = 1
        container.ClipsDescendants = false
        container.ZIndex = 50
        container.Parent = parent

        MakeText(container, label, UDim2.fromOffset(0,0), UDim2.new(1,0,0,18), 12, WHITE)

        local drop = Instance.new("Frame")
        drop.Position = UDim2.fromOffset(0,20)
        drop.Size = UDim2.new(1,0,0,28)
        drop.BackgroundColor3 = DROPBG
        drop.BorderSizePixel = 0
        drop.ZIndex = 51
        drop.Parent = container
        Stroke(drop,1)

        local selText = MakeText(drop, default or (options[1] or ""), UDim2.fromOffset(8,0), UDim2.new(1,-30,1,0), 12, WHITE)
        selText.ZIndex = 52

        local arrow = MakeText(drop, "v", UDim2.new(1,-22,0,0), UDim2.fromOffset(20,28), 11, WHITE)
        arrow.TextXAlignment = Enum.TextXAlignment.Center
        arrow.ZIndex = 52

        local click = Instance.new("TextButton")
        click.Size = UDim2.fromScale(1,1)
        click.BackgroundTransparency = 1
        click.Text = ""
        click.ZIndex = 55
        click.Parent = drop

        local menu = Instance.new("Frame")
        menu.Position = UDim2.fromOffset(0,29)
        menu.Size = UDim2.new(1,0,0,#options*24)
        menu.BackgroundColor3 = DROPBG
        menu.BorderSizePixel = 0
        menu.Visible = false
        menu.ZIndex = 100
        menu.Parent = drop
        Stroke(menu,1)

        for i,opt in ipairs(options) do
            local ob = Instance.new("TextButton")
            ob.Position = UDim2.fromOffset(0,(i-1)*24)
            ob.Size = UDim2.new(1,0,0,24)
            ob.BackgroundColor3 = DROPBG
            ob.BorderSizePixel = 0
            ob.Text = opt
            ob.TextColor3 = WHITE
            ob.Font = Enum.Font.Code
            ob.TextSize = 12
            ob.TextXAlignment = Enum.TextXAlignment.Left
            ob.AutoButtonColor = false
            ob.ZIndex = 101
            ob.Parent = menu
            Instance.new("UIPadding",ob).PaddingLeft = UDim.new(0,8)
            ob.MouseButton1Click:Connect(function()
                selText.Text = opt
                menu.Visible = false
                if callback then pcall(callback, opt) end
            end)
        end

        click.MouseButton1Click:Connect(function()
            menu.Visible = not menu.Visible
        end)
        return container
    end

    local function KeybindRow(parent, label, default, setter)
        local container = Instance.new("Frame")
        container.Size = UDim2.new(1,0,0,24)
        container.BackgroundTransparency = 1
        container.Parent = parent

        MakeText(container, label, UDim2.fromOffset(0,0), UDim2.new(1,-80,1,0), 13, WHITE)

        local kb = Instance.new("TextButton")
        kb.AnchorPoint = Vector2.new(1,0)
        kb.Position = UDim2.new(1,0,0,3)
        kb.Size = UDim2.fromOffset(70,18)
        kb.BackgroundColor3 = CHECKBG
        kb.BorderSizePixel = 0
        kb.Text = default.Name
        kb.TextColor3 = WHITE
        kb.Font = Enum.Font.Code
        kb.TextSize = 11
        kb.AutoButtonColor = false
        kb.Parent = container
        Stroke(kb,1)

        local waiting = false
        kb.MouseButton1Click:Connect(function()
            waiting = true
            kb.Text = "..."
        end)
        UIS.InputBegan:Connect(function(inp,gpe)
            if waiting and not gpe and inp.UserInputType == Enum.UserInputType.Keyboard then
                setter(inp.KeyCode)
                kb.Text = inp.KeyCode.Name
                waiting = false
            end
        end)
        return container
    end

    local function Section(parent, title)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1,0,0,24)
        f.BackgroundColor3 = PANEL
        f.BorderSizePixel = 0
        f.Parent = parent
        Stroke(f,1)
        MakeText(f,title,UDim2.fromOffset(8,0),UDim2.new(1,-16,1,0),13,ACCENT)
        return f
    end

    A.Stroke = Stroke
    A.MakeText = MakeText
    A.Checkbox = Checkbox
    A.Slider = Slider
    A.Dropdown = Dropdown
    A.KeybindRow = KeybindRow
    A.Section = Section

    print("[Astra] Helpers initialized")
end

-- MAIN GUI
do
    local A = _G.A
    local GUI_PARENT = A.GUI_PARENT
    local WHITE = A.WHITE
    local GRAY = A.GRAY
    local ACCENT = A.ACCENT
    local BG = A.BG
    local UIS = A.UIS
    local Camera = A.Camera
    local Stroke = A.Stroke
    local MakeText = A.MakeText

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ProjectAstra"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() ScreenGui.Parent = GUI_PARENT end)
    if not ScreenGui.Parent then
        ScreenGui.Parent = A.LP:WaitForChild("PlayerGui")
    end

    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.fromOffset(944,593)
    Main.BackgroundColor3 = BG
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Parent = ScreenGui

    local MainScale = Instance.new("UIScale")
    MainScale.Scale = 0.55
    MainScale.Parent = Main
    Stroke(Main,1.5)

    local function CenterMain()
        local vp = Camera.ViewportSize
        local w = Main.Size.X.Offset * MainScale.Scale
        local h = Main.Size.Y.Offset * MainScale.Scale
        Main.Position = UDim2.fromOffset((vp.X-w)/2,(vp.Y-h)/2)
    end
    CenterMain()
    A.CenterMain = CenterMain

    local TitleBar = Instance.new("Frame")
    TitleBar.Size = UDim2.new(1,0,0,41)
    TitleBar.BackgroundColor3 = Color3.fromRGB(30,20,35)
    TitleBar.BorderSizePixel = 0
    TitleBar.ClipsDescendants = true
    TitleBar.Parent = Main

    local TitleGradient = Instance.new("UIGradient", TitleBar)
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(60,20,80)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120,30,120)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(40,15,60)),
    })
    MakeText(TitleBar, "Project Astra  |  t.me/epsteinhub", UDim2.fromOffset(12,0), UDim2.new(1,-24,1,0), 14, WHITE)

    local SepLine = Instance.new("Frame")
    SepLine.Position = UDim2.new(0,0,0,41)
    SepLine.Size = UDim2.new(1,0,0,1)
    SepLine.BackgroundColor3 = ACCENT
    SepLine.BorderSizePixel = 0
    SepLine.Parent = Main

    local Tabs = Instance.new("Frame")
    Tabs.Position = UDim2.fromOffset(0,42)
    Tabs.Size = UDim2.new(1,0,0,40)
    Tabs.BackgroundColor3 = BG
    Tabs.BorderSizePixel = 0
    Tabs.Parent = Main

    local TabNames = {"Combat","Visuals","Misc","Settings"}
    local TabButtons = {}

    for i,name in ipairs(TabNames) do
        local b = Instance.new("TextButton")
        b.Position = UDim2.new((i-1)*0.25,0,0,0)
        b.Size = UDim2.new(0.25,0,1,0)
        b.BackgroundTransparency = 1
        b.BorderSizePixel = 0
        b.Text = name
        b.TextColor3 = i==1 and WHITE or GRAY
        b.Font = Enum.Font.Code
        b.TextSize = 14
        b.AutoButtonColor = false
        b.Parent = Tabs
        TabButtons[i] = b
    end

    local SepLine2 = Instance.new("Frame")
    SepLine2.Position = UDim2.new(0,0,0,82)
    SepLine2.Size = UDim2.new(1,0,0,1)
    SepLine2.BackgroundColor3 = ACCENT
    SepLine2.BorderSizePixel = 0
    SepLine2.Parent = Main

    local Pages = {}
    local ScrollsL = {}
    local ScrollsR = {}

    for i,name in ipairs(TabNames) do
        local page = Instance.new("Frame")
        page.Name = name
        page.Position = UDim2.fromOffset(0,83)
        page.Size = UDim2.new(1,0,1,-83)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.Visible = (i==1)
        page.Parent = Main

        local left = Instance.new("ScrollingFrame")
        left.Position = UDim2.new(0,0,0,0)
        left.Size = UDim2.new(0.5,-4,1,0)
        left.BackgroundTransparency = 1
        left.BorderSizePixel = 0
        left.ScrollBarThickness = 3
        left.ScrollBarImageColor3 = ACCENT
        left.AutomaticCanvasSize = Enum.AutomaticSize.Y
        left.CanvasSize = UDim2.new()
        left.Parent = page
        local layoutL = Instance.new("UIListLayout",left)
        layoutL.Padding = UDim.new(0,4)
        layoutL.SortOrder = Enum.SortOrder.LayoutOrder
        local padL = Instance.new("UIPadding",left)
        padL.PaddingTop = UDim.new(0,8)
        padL.PaddingLeft = UDim.new(0,8)
        padL.PaddingRight = UDim.new(0,4)
        padL.PaddingBottom = UDim.new(0,8)

        local right = Instance.new("ScrollingFrame")
        right.Position = UDim2.new(0.5,4,0,0)
        right.Size = UDim2.new(0.5,-4,1,0)
        right.BackgroundTransparency = 1
        right.BorderSizePixel = 0
        right.ScrollBarThickness = 3
        right.ScrollBarImageColor3 = ACCENT
        right.AutomaticCanvasSize = Enum.AutomaticSize.Y
        right.CanvasSize = UDim2.new()
        right.Parent = page
        local layoutR = Instance.new("UIListLayout",right)
        layoutR.Padding = UDim.new(0,4)
        layoutR.SortOrder = Enum.SortOrder.LayoutOrder
        local padR = Instance.new("UIPadding",right)
        padR.PaddingTop = UDim.new(0,8)
        padR.PaddingLeft = UDim.new(0,4)
        padR.PaddingRight = UDim.new(0,8)
        padR.PaddingBottom = UDim.new(0,8)

        Pages[i] = page
        ScrollsL[i] = left
        ScrollsR[i] = right
    end

    local function SelectTab(index)
        for i,page in ipairs(Pages) do page.Visible = (i==index) end
        for i,btn in ipairs(TabButtons) do
            btn.TextColor3 = i==index and WHITE or GRAY
        end
    end
    for i,btn in ipairs(TabButtons) do
        btn.MouseButton1Click:Connect(function() SelectTab(i) end)
    end
    SelectTab(1)

    -- Side panel
    local Side = Instance.new("Frame")
    Side.Size = UDim2.fromOffset(161,87)
    Side.Position = UDim2.fromOffset(68,185)
    Side.BackgroundColor3 = BG
    Side.BorderSizePixel = 0
    Side.Parent = ScreenGui
    local SideScale = Instance.new("UIScale")
    SideScale.Scale = 0.55
    SideScale.Parent = Side
    Stroke(Side,1)

    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(1,0,0,43)
    ToggleButton.BackgroundTransparency = 1
    ToggleButton.BorderSizePixel = 0
    ToggleButton.Text = "Toggle UI"
    ToggleButton.TextColor3 = WHITE
    ToggleButton.Font = Enum.Font.Code
    ToggleButton.TextSize = 14
    ToggleButton.AutoButtonColor = false
    ToggleButton.Parent = Side

    local SideSep = Instance.new("Frame")
    SideSep.Position = UDim2.fromOffset(0,43)
    SideSep.Size = UDim2.new(1,0,0,1)
    SideSep.BackgroundColor3 = ACCENT
    SideSep.BorderSizePixel = 0
    SideSep.Parent = Side

    local LockButton = Instance.new("TextButton")
    LockButton.Position = UDim2.fromOffset(0,44)
    LockButton.Size = UDim2.new(1,0,0,43)
    LockButton.BackgroundTransparency = 1
    LockButton.BorderSizePixel = 0
    LockButton.Text = "Lock UI"
    LockButton.TextColor3 = WHITE
    LockButton.Font = Enum.Font.Code
    LockButton.TextSize = 14
    LockButton.AutoButtonColor = false
    LockButton.Parent = Side

    local MainVisible = true
    local Locked = false

    ToggleButton.MouseButton1Click:Connect(function()
        MainVisible = not MainVisible
        Main.Visible = MainVisible
    end)
    LockButton.MouseButton1Click:Connect(function()
        Locked = not Locked
        LockButton.Text = Locked and "Unlock UI" or "Lock UI"
    end)

    local dragging = false
    local dragStart, startPos
    TitleBar.InputBegan:Connect(function(i)
        if Locked then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = i.Position
            startPos = Main.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            Main.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    A.Main = Main
    A.ScrollsL = ScrollsL
    A.ScrollsR = ScrollsR
    A.Pages = Pages
    A.ScreenGui = ScreenGui

    print("[Astra] Main GUI created")
end

-- COMBAT TAB
do
    local A = _G.A
    local CL = A.ScrollsL[1]
    local CR = A.ScrollsR[1]
    local Checkbox = A.Checkbox
    local Slider = A.Slider
    local Dropdown = A.Dropdown
    local Section = A.Section

    Section(CL, "SILENT AIM")
    Checkbox(CL, "Enable Silent Aim", false, function(v) A.SILENT_AIM = v end)
    Checkbox(CL, "Team Check", false, function(v) A.TEAM_CHECK = v end)
    Checkbox(CL, "Show FOV", true, function(v) A.SHOW_FOV = v end)
    Checkbox(CL, "Snapline", false, function(v) A.SNAPLINE = v end)
    Slider(CL, "Hit Chance", 0, 100, 95, function(v) A.HIT_CHANCE = v end, "%")
    Slider(CL, "FOV Radius", 1, 500, 200, function(v) A.FOV_RADIUS = v end, "px")
    Dropdown(CL, "Hit Part", {"Head","Torso","HumanoidRootPart","Random"}, "Head", function(v) A.HIT_PART = v end)

    Section(CL, "BULLET TRACER")
    Checkbox(CL, "Enable Tracer", false, function(v) A.TRACER = v end)
    Slider(CL, "Lifetime", 1, 10, 3, function(v) A.TRACER_LIFE = v end, "s")
    Dropdown(CL, "Type", {"Red Laser","Neon Linia Bruh"}, "Red Laser", function(v) A.TRACER_TYPE = v end)

    Section(CR, "RAPID FIRE")
    Checkbox(CR, "Enable Rapid Fire", false, function(v) A.RAPID_FIRE = v end)
    Slider(CR, "Rate Value (x100k)", 1, 100, 100, function(v) A.RAPID_VALUE = v * 100000 end)

    Section(CR, "WEAPON")
    Checkbox(CR, "Instant Hit", false, function(v) A.instantHitEnabled = v end)
    Checkbox(CR, "No Recoil", false, function(v) A.noRecoilEnabled = v end)
    Checkbox(CR, "No Spread", false, function(v) A.noSpreadEnabled = v end)
    Checkbox(CR, "Instant Reload", false, function(v) A.instantReloadEnabled = v end)
    Checkbox(CR, "Auto Reload", false, function(v) A.autoReloadEnabled = v end)
    Checkbox(CR, "No Equip Delay", false, function(v) A.noEquipDelayEnabled = v end)
    Checkbox(CR, "Full Auto", false, function(v) A.fullAutoEnabled = v end)
    Slider(CR, "Bullet Speed", 500, 5000, 5000, function(v) A.bulletSpeedValue = v end)

    Section(CR, "HIT MARKER")
    Checkbox(CR, "Enable Hit Marker", true, function(v) A.hitMarkerEnabled = v end)
    Slider(CR, "Marker Size", 4, 30, 9, function(v) A.hitMarkerSize = v end, "px")
    Slider(CR, "Duration (x10ms)", 1, 100, 35, function(v) A.hitMarkerDuration = v/100 end, "s")

    Section(CR, "HIT SOUND")
    Checkbox(CR, "Enable Hit Sound", false, function(v) A.HIT_SOUND = v end)
    Slider(CR, "Volume", 0, 10, 1, function(v) A.HIT_SOUND_VOL = v end)

    print("[Astra] Combat tab done")
end

-- VISUALS TAB
do
    local A = _G.A
    local VL = A.ScrollsL[2]
    local VR = A.ScrollsR[2]
    local Checkbox = A.Checkbox
    local Slider = A.Slider
    local Dropdown = A.Dropdown
    local Section = A.Section

    Section(VL, "ESP")
    Checkbox(VL, "Enable ESP", false, function(v) A.espEnabled = v end)
    Checkbox(VL, "Box", true, function(v) A.espBox = v end)
    Checkbox(VL, "Name", true, function(v) A.espName = v end)
    Checkbox(VL, "Health", true, function(v) A.espHealth = v end)
    Checkbox(VL, "Distance", true, function(v) A.espDistance = v end)
    Checkbox(VL, "Weapon", true, function(v) A.espWeapon = v end)

    Section(VL, "CUSTOM HANDS")
    Checkbox(VL, "Enable Custom Hands", false, function(v)
        A.customHandsEnabled = v
        if v then
            if A.SetupCustomHands then A.SetupCustomHands() end
        else
            A.activeLockedArms = {}
        end
    end)
    Slider(VL, "Hands Transparency", 0, 100, 55, function(v) A.customHandsTransp = v/100 end, "%")

    Section(VL, "VIEW MODEL")
    Checkbox(VL, "Enable View Model", false, function(v)
        A.viewModelEnabled = v
        if v then
            if A.ApplyViewModel then A.ApplyViewModel() end
        else
            if A.RemoveViewModel then A.RemoveViewModel() end
        end
    end)
    Slider(VL, "X", -20, 20, 5, function(v) A.viewModelX = v end)
    Slider(VL, "Y", -20, 20, -2, function(v) A.viewModelY = v end)
    Slider(VL, "Z", -20, 20, -8, function(v) A.viewModelZ = v end)

    Section(VR, "GUN CHAMS")
    Checkbox(VR, "Enable Gun Chams", false, function(v) A.gunChamsEnabled = v end)

    Section(VR, "GAMMA")
    local Lighting = A.Lighting
    Checkbox(VR, "Enable Gamma", false, function(v)
        A.gammaEnabled = v
        if v then
            Lighting.Ambient = A.gammaColor
            Lighting.OutdoorAmbient = A.gammaColor
            Lighting.Brightness = A.gammaValue/10
        else
            Lighting.Ambient = Color3.fromRGB(128,128,128)
            Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
            Lighting.Brightness = 1
        end
    end)
    Slider(VR, "Gamma Brightness (x0.1)", 1, 50, 10, function(v)
        A.gammaValue = v
        if A.gammaEnabled then Lighting.Brightness = v/10 end
    end)

    Section(VR, "FOG")
    Checkbox(VR, "Enable Fog", false, function(v)
        A.fogEnabled = v
        if v then
            Lighting.FogStart = A.fogStart
            Lighting.FogEnd = A.fogEnd
        else
            Lighting.FogEnd = 100000
            Lighting.FogStart = 0
        end
    end)
    Slider(VR, "Fog Start", 0, 2000, 100, function(v)
        A.fogStart = v
        if A.fogEnabled then Lighting.FogStart = v end
    end)
    Slider(VR, "Fog End", 50, 5000, 500, function(v)
        A.fogEnd = v
        if A.fogEnabled then Lighting.FogEnd = v end
    end)

    Section(VR, "SKYBOX")
    Checkbox(VR, "Enable Skybox", false, function(v)
        A.skyboxEnabled = v
        if not v and A.activeSky then A.activeSky:Destroy() A.activeSky = nil end
        if v and A.ApplySkybox then A.ApplySkybox(A.skyboxMode) end
    end)
    Dropdown(VR, "Skybox Preset",
        {"None","Aurorka","Galaxy","Godly","Super Sayien","North Star","Blue Lord","Pink Aura","Angel Wing","Sweet Heart","Ethereal Aura"},
        "None", function(v)
            A.skyboxMode = v
            if A.skyboxEnabled and A.ApplySkybox then A.ApplySkybox(v) end
        end)

    Section(VR, "CAMERA / WORLD")
    Checkbox(VR, "Custom FOV", false, function(v) A.cameraFovEnabled = v end)
    Slider(VR, "FOV Value", 60, 160, 120, function(v) A.cameraFovValue = v end)
    Checkbox(VR, "No Fog", false, function(v)
        A.noFogEnabled = v
        if v then Lighting.FogEnd = 1e6 Lighting.FogStart = 1e5
        else Lighting.FogEnd = 100000 Lighting.FogStart = 0 end
    end)
    Checkbox(VR, "Fullbright", false, function(v)
        A.fullbrightEnabled = v
        if v then
            Lighting.Brightness = 3
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e9
        else
            Lighting.Brightness = 1
            Lighting.GlobalShadows = true
            Lighting.FogEnd = 100000
        end
    end)

    print("[Astra] Visuals tab done")
end

