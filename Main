local whitelistFrame = Instance.new("ScrollingFrame")
whitelistFrame.Position = UDim2.fromOffset(10, sY)
whitelistFrame.Size = UDim2.new(1,-20,0,140)
whitelistFrame.BackgroundColor3 = PANEL
whitelistFrame.BorderSizePixel = 0
whitelistFrame.ScrollBarThickness = 3
whitelistFrame.ScrollBarImageColor3 = ACCENT_COLOR
whitelistFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
whitelistFrame.CanvasSize = UDim2.new()
whitelistFrame.Parent = SetScroll
Stroke(whitelistFrame,1)
Instance.new("UIListLayout",whitelistFrame).Padding = UDim.new(0,3)
sY = sY + 146

function RenderWhitelist()
    for _,c in ipairs(whitelistFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1,-6,0,22)
            b.BackgroundColor3 = whitelist[p.Name] and Color3.fromRGB(90,30,160) or Color3.fromRGB(20,20,20)
            b.BorderSizePixel = 0
            b.Text = p.Name .. (whitelist[p.Name] and "  OK" or "")
            b.TextColor3 = WHITE
            b.Font = Enum.Font.Code
            b.TextSize = 11
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.AutoButtonColor = false
            b.Parent = whitelistFrame
            Instance.new("UIPadding",b).PaddingLeft = UDim.new(0,6)
            b.MouseButton1Click:Connect(function()
                whitelist[p.Name] = not whitelist[p.Name] or nil
                RenderWhitelist()
            end)
        end
    end
end

Players.PlayerAdded:Connect(RenderWhitelist)
Players.PlayerRemoving:Connect(RenderWhitelist)
RenderWhitelist()

