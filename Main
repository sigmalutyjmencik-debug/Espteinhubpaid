-- SILENT AIM TARGET
local function getSilentTarget()
    local best, bd = nil, silentAimFov
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    for _,p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if silentAimTeamCheck and p.Team == LP.Team then continue end
        if IsWhitelisted(p) then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local partName = silentAimPart
        if partName == "Random" then
            local opts = {"Head","Torso","HumanoidRootPart"}
            partName = opts[math.random(1, #opts)]
        end
        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head")
        if not part then continue end

        if silentAimVisCheck then
            local rp = RaycastParams.new()
            local filter = {Camera}
            if LP.Character then table.insert(filter, LP.Character) end
            rp.FilterDescendantsInstances = filter
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local ray = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000, rp)
            if not ray or not ray.Instance or not ray.Instance:IsDescendantOf(char) then continue end
        end

        local pos, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist < bd then bd = dist; best = part end
    end
    return best
end

-- BULLET TRACER
local function CreateTracer(from, to)
    if not bulletTracerEnabled then return end
    if (to - from).Magnitude < 1 then return end

    local holder = Instance.new("Part")
    holder.Name = "AstraTracer"
    holder.Size = Vector3.new(0.05,0.05,0.05)
    holder.Transparency = 1
    holder.Anchored = true
    holder.CanCollide = false
    holder.CanTouch = false
    holder.CanQuery = false
    holder.Position = from
    holder.Parent = workspace

    local a0 = Instance.new("Attachment", holder)
    a0.WorldPosition = from
    local a1 = Instance.new("Attachment", holder)
    a1.WorldPosition = to

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0

    if bulletTracerType == "Red Laser" then
        beam.Texture = "rbxassetid://6060542021"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 3
        beam.Width0 = 1.2
        beam.Width1 = 1.2
        beam.Color = ColorSequence.new(Color3.fromRGB(255,10,10))
    else
        beam.Texture = "rbxassetid://10259604258"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 2
        beam.Width0 = 0.4
        beam.Width1 = 0.4
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150,50,220)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
        })
    end

    beam.Parent = holder
    Debris:AddItem(holder, bulletTracerLife)
end

-- DAMAGE TRACKING + HIT MARKER
local function watchHumanoid(plr)
    local function hook(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local last = hum.Health
        hum.HealthChanged:Connect(function(h)
            if h < last then
                damageEvents[plr] = tick()
            end
            last = h
        end)
    end
    if plr.Character then hook(plr.Character) end
    plr.CharacterAdded:Connect(hook)
end

for _,p in ipairs(Players:GetPlayers()) do
    if p ~= LP then watchHumanoid(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LP then watchHumanoid(p) end
end)

local function wasDamagedRecently(plr)
    if not plr then return false end
    local t = damageEvents[plr]
    return t and (tick() - t) <= DAMAGE_WINDOW
end

local function CreateHitmarker(pos3D)
    if not hitMarkerEnabled then return end
    local vp, onScreen = Camera:WorldToViewportPoint(pos3D)
    if not onScreen then return end

    local marker = Instance.new("Frame")
    marker.AnchorPoint = Vector2.new(0.5,0.5)
    marker.Position = UDim2.fromOffset(vp.X, vp.Y)
    marker.Size = UDim2.fromOffset(hitMarkerSize*2, hitMarkerSize*2)
    marker.BackgroundTransparency = 1
    marker.Parent = ScreenGui

    for i=1,4 do
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5,0.5)
        line.Size = UDim2.fromOffset(2, hitMarkerSize)
        line.BackgroundColor3 = hitMarkerColor
        line.BorderSizePixel = 0
        local offset = 8
        if i == 1 then line.Position = UDim2.new(0.5,0,0.5,-offset)
        elseif i == 2 then line.Position = UDim2.new(0.5,offset,0.5,0); line.Rotation = 90
        elseif i == 3 then line.Position = UDim2.new(0.5,0,0.5,offset)
        elseif i == 4 then line.Position = UDim2.new(0.5,-offset,0.5,0); line.Rotation = 90
        end
        line.Parent = marker
    end

    task.delay(0.35, function()
        if marker and marker.Parent then marker:Destroy() end
    end)
end

-- JUMP SHOT
function ApplyJumpShot()
    if not getgc then return end
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                local ok, canShoot = pcall(function() return rawget(v, "canShoot") end)
                if ok and canShoot and type(canShoot) == "function" and not jumpShotPatched[v] then
                    local orig = canShoot
                    jumpShotPatched[v] = true
                    v.canShoot = function(...)
                        if jumpShotEnabled then
                            return true
                        end
                        return orig(...)
                    end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(2)
        if jumpShotEnabled then
            ApplyJumpShot()
        end
    end
end)

-- CLICK TRACKING (tracer + hitmarker)
local lastClickTime = 0
UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if tick() - lastClickTime < 0.05 then return end
        lastClickTime = tick()

        if silentAimEnabled then
            local target = getSilentTarget()
            if target then
                if bulletTracerEnabled then
                    pcall(function() CreateTracer(Camera.CFrame.Position, target.Position) end)
                end

                local targetChar = target.Parent
                local targetPos = target.Position
                task.spawn(function()
                    task.wait(0.08)
                    local plrTarget = nil
                    pcall(function()
                        if targetChar then
                            plrTarget = Players:GetPlayerFromCharacter(targetChar)
                        end
                    end)
                    if plrTarget then
                        if wasDamagedRecently(plrTarget) then
                            pcall(function() CreateHitmarker(targetPos) end)
                            if hitSoundEnabled and hitSoundObj then
                                pcall(function() hitSoundObj:Play() end)
                            end
                        end
                    else
                        pcall(function() CreateHitmarker(targetPos) end)
                    end
                end)
            end
        end
    end
end)

-- SNAPLINE + FOV RENDER
RS.RenderStepped:Connect(function()
    local vp = Camera.ViewportSize
    local cx = vp.X/2
    local cy = vp.Y/2
    FOVFrame.Position = UDim2.fromOffset(cx - silentAimFov, cy - silentAimFov)
    FOVFrame.Size = UDim2.fromOffset(silentAimFov*2, silentAimFov*2)
    FOVFrame.Visible = silentAimShowFov and silentAimEnabled
    FOVStroke.Color = silentAimFovColor

    if snapLine then
        if not silentAimEnabled or not silentAimSnapline then
            snapLine.Visible = false
        else
            local t = getSilentTarget()
            if not t then
                snapLine.Visible = false
            else
                local pos, onS = Camera:WorldToViewportPoint(t.Position)
                if not onS then
                    snapLine.Visible = false
                else
                    snapLine.From = Vector2.new(cx, cy)
                    snapLine.To = Vector2.new(pos.X, pos.Y)
                    snapLine.Color = silentAimSnaplineColor
                    snapLine.Visible = true
                end
            end
        end
    end
end)

-- RAPID FIRE
local function processToolForRapidFire(tool)
    if not rapidFireEnabled then return end
    if not tool or not tool:IsA("Tool") then return end
    for attrName, _ in pairs(tool:GetAttributes()) do
        if attrName:lower() == "rateoffire" then
            pcall(function()
                tool:SetAttribute(attrName, rapidFireValue)
            end)
        end
    end
end

local function hookCharForRapid(char)
    if not char then return end
    for _,item in ipairs(char:GetChildren()) do
        processToolForRapidFire(item)
    end
    char.ChildAdded:Connect(function(child)
        task.wait(0.05)
        processToolForRapidFire(child)
    end)
end

if LP.Character then hookCharForRapid(LP.Character) end
LP.CharacterAdded:Connect(hookCharForRapid)

task.spawn(function()
    while true do
        task.wait(0.5)
        if rapidFireEnabled and LP.Character then
            for _,item in ipairs(LP.Character:GetChildren()) do
                processToolForRapidFire(item)
            end
        end
    end
end)

-- CUSTOM HANDS
local TARGET_ARM_NAMES = {
    ["RightArm"] = true,
    ["LeftArm"] = true,
    ["SleeveL"] = true,
    ["SleeveR"] = true,
}

local function ForceHandsStyle(part)
    if not part or not part.Parent then return end
    local pbr = part:FindFirstChildOfClass("SurfaceAppearance")
    if pbr then pbr:Destroy() end
    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm and sm.TextureId ~= "" then sm.TextureId = "" end
    if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
    for _,c in ipairs(part:GetChildren()) do
        if c:IsA("Texture") or c:IsA("Decal") or c:IsA("Clothing") then
            c:Destroy()
        end
    end
    part.Color = customHandsColor
    part.Transparency = customHandsTransp
    part.Material = Enum.Material.Neon
    pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
end

local function BindArm(part)
    if activeLockedArms[part] then return end
    activeLockedArms[part] = true
    ForceHandsStyle(part)
    local busy = false
    part.Changed:Connect(function(prop)
        if busy or not part.Parent or not customHandsEnabled then return end
        if prop == "Color" or prop == "Transparency" or prop == "Material" or prop == "LocalTransparencyModifier" then
            busy = true
            part.Color = customHandsColor
            part.Transparency = customHandsTransp
            part.Material = Enum.Material.Neon
            pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
            busy = false
        end
    end)
end

function SetupCustomHands()
    for _,obj in ipairs(game:GetDescendants()) do
        if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
            BindArm(obj)
        end
    end
end

function RemoveCustomHands()
    activeLockedArms = {}
end

game.DescendantAdded:Connect(function(d)
    if customHandsEnabled and d:IsA("BasePart") and TARGET_ARM_NAMES[d.Name] then
        task.wait()
        BindArm(d)
    end
end)

task.spawn(function()
    while true do
        task.wait(1.5)
        if customHandsEnabled then
            pcall(function()
                for _,obj in ipairs(game:GetDescendants()) do
                    if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
                        BindArm(obj)
                    end
                end
            end)
        end
    end
end)

LP.CharacterAdded:Connect(function()
    activeLockedArms = {}
    if customHandsEnabled then
        task.wait(0.5)
        SetupCustomHands()
    end
end)

-- SKYBOX
function ApplySkybox(name)
    if activeSky then activeSky:Destroy(); activeSky = nil end
    if name == "None" then return end

    for _,o in ipairs(Lighting:GetChildren()) do
        if o:IsA("Sky") then o:Destroy() end
    end

    local s = Instance.new("Sky")

    if name == "Gothbreach" then
        s.SkyboxFt = "rbxassetid://99674108178510"
        s.SkyboxBk = "rbxassetid://76898653037615"
        s.SkyboxLf = "rbxassetid://78775818685659"
        s.SkyboxRt = "rbxassetid://117864739442861"
        s.SkyboxUp = "rbxassetid://94326041205929"
        s.SkyboxDn = "rbxassetid://134726625576772"
        s.CelestialBodiesShown = false
        s.SunTextureId = ""
        s.MoonTextureId = ""
        Lighting.ClockTime = 12
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.fromRGB(128,128,128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
        Lighting.ColorShift_Top = Color3.fromRGB(0,0,0)
    elseif name == "Epstein" then
        local id = "rbxassetid://159454299"
        s.SkyboxBk = id; s.SkyboxDn = id; s.SkyboxFt = id
        s.SkyboxLf = id; s.SkyboxRt = id; s.SkyboxUp = id
    else
        local id = SKYBOXES[name]
        if id then
            s.SkyboxBk = id; s.SkyboxDn = id; s.SkyboxFt = id
            s.SkyboxLf = id; s.SkyboxRt = id; s.SkyboxUp = id
        end
    end

    s.Parent = Lighting
    activeSky = s
end

-- ESP
local function createESP(player)
    if espCache[player] then return end
    if not Drawing then return end
    local o = {
        Box       = Drawing.new("Square"),
        Name      = Drawing.new("Text"),
        HPBar     = Drawing.new("Square"),
        HPBg      = Drawing.new("Square"),
        Dist      = Drawing.new("Text"),
        Weapon    = Drawing.new("Text"),
    }
    o.Box.Filled = false
    o.Box.Thickness = 1.5
    o.Name.Size = 14; o.Name.Center = true; o.Name.Outline = true
    o.HPBg.Filled = true; o.HPBg.Color = Color3.fromRGB(40,40,40)
    o.HPBar.Filled = true
    o.Dist.Size = 12; o.Dist.Center = true; o.Dist.Outline = true
    o.Weapon.Size = 12; o.Weapon.Center = true; o.Weapon.Outline = true
    for _,d in pairs(o) do d.Visible = false end
    espCache[player] = o
end

local function removeESP(player)
    if espCache[player] then
        for _,d in pairs(espCache[player]) do pcall(function() d:Remove() end) end
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(function(p) if p ~= LP then createESP(p) end end)
Players.PlayerRemoving:Connect(removeESP)
for _,p in ipairs(Players:GetPlayers()) do if p ~= LP then createESP(p) end end

local function getEquippedWeapon(char)
    local tool = char:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Fists"
end

RS.RenderStepped:Connect(function()
    for player, o in pairs(espCache) do
        local char = player.Character
        local visible = espEnabled and not IsWhitelisted(player)

        if visible and char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum  = char:FindFirstChildOfClass("Humanoid")

            if root and head and hum and hum.Health > 0 then
                local headPos, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                local legPos, on2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

                if on1 and on2 then
                    local boxH = math.abs(headPos.Y - legPos.Y)
                    local boxW = boxH / 1.6
                    local bx = headPos.X - boxW/2
                    local by = headPos.Y

                    if espBox then
                        o.Box.Size = Vector2.new(boxW, boxH)
                        o.Box.Position = Vector2.new(bx, by)
                        o.Box.Color = espBoxColor
                        o.Box.Visible = true
                    else o.Box.Visible = false end

                    if espName then
                        o.Name.Text = player.Name
                        o.Name.Position = Vector2.new(headPos.X, by - 16)
                        o.Name.Color = espNameColor
                        o.Name.Visible = true
                    else o.Name.Visible = false end

                    if espHealth then
                        local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        local barH = boxH * hp
                        o.HPBg.Size = Vector2.new(4, boxH)
                        o.HPBg.Position = Vector2.new(bx - 6, by)
                        o.HPBg.Visible = true
                        o.HPBar.Size = Vector2.new(4, barH)
                        o.HPBar.Position = Vector2.new(bx - 6, by + (boxH - barH))
                        o.HPBar.Color = Color3.fromHSV(hp * 0.33, 1, 1)
                        o.HPBar.Visible = true
                    else
                        o.HPBg.Visible = false
                        o.HPBar.Visible = false
                    end

                    if espDistance then
                        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        local d = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                        o.Dist.Text = d .. " studs"
                        o.Dist.Position = Vector2.new(headPos.X, legPos.Y + 4)
                        o.Dist.Color = espDistColor
                        o.Dist.Visible = true
                    else o.Dist.Visible = false end

                    if espWeapon then
                        o.Weapon.Text = getEquippedWeapon(char)
                        o.Weapon.Position = Vector2.new(headPos.X, legPos.Y + 18)
                        o.Weapon.Color = espWeapColor
                        o.Weapon.Visible = true
                    else o.Weapon.Visible = false end
                else
                    for _,d in pairs(o) do d.Visible = false end
                end
            else
                for _,d in pairs(o) do d.Visible = false end
            end
        else
            for _,d in pairs(o) do d.Visible = false end
        end
    end
end)

-- MAIN HEARTBEAT
local wasInAirBhop = false

RS.Heartbeat:Connect(function(dt)
    if cameraFovEnabled and Camera.FieldOfView ~= cameraFovValue then
        Camera.FieldOfView = cameraFovValue
    end
    if noFogEnabled and Lighting.FogEnd ~= 1e6 then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e5
    end
    if fullbrightEnabled then
        if Lighting.Brightness ~= 3 then Lighting.Brightness = 3 end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
    end

    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if noClipEnabled then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if speedHackEnabled and hum.WalkSpeed ~= speedValue then
        hum.WalkSpeed = speedValue
    end

    if bigJumpEnabled then
        hum.UseJumpPower = true
        if hum.JumpPower ~= bigJumpPower then hum.JumpPower = bigJumpPower end
    end

    if flyEnabled then
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end
        root.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.zero
        hum.PlatformStand = true
    elseif hum.PlatformStand and not freezeEnabled and not airWalkBusy then
        hum.PlatformStand = false
    end

    if freezeEnabled and UIS:IsKeyDown(keybinds.Freeze) then
        if not freezeTargetCF then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
        end
        root.CFrame = freezeTargetCF
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        hum.PlatformStand = true
    elseif freezeTargetCF then
        freezeTargetCF = nil
        hum.PlatformStand = false
    end

    if bhopEnabled then
        local state = hum:GetState()
        local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        if not inAir and wasInAirBhop then
            hum.Jump = true
        end
        wasInAirBhop = inAir
    end

    if gunChamsEnabled then
        for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _,p in ipairs(tool:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Color = gunChamsColor
                        p.Material = Enum.Material.Neon
                    end
                end
            end
        end
    end
end)

-- JUMP
UIS.JumpRequest:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if infJumpEnabled then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- AIR WALK
function DoAirWalk()
    if airWalkBusy then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    airWalkBusy = true

    local targetY = root.Position.Y + airWalkHeight
    root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z) * root.CFrame.Rotation

    local bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(0, math.huge, 0)
    bodyPos.Position = Vector3.new(0, targetY, 0)
    bodyPos.P = 25000
    bodyPos.Parent = root

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, 0, math.huge)
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    hum:ChangeState(Enum.HumanoidStateType.Running)

    task.wait(airWalkDuration)

    if bodyPos then bodyPos:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end

    local currentPos = root.Position
    root.CFrame = CFrame.new(currentPos.X, currentPos.Y - airWalkHeight, currentPos.Z) * root.CFrame.Rotation
    root.Velocity = Vector3.zero
    root.AssemblyLinearVelocity = Vector3.zero
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)

    airWalkBusy = false
end

-- TELEPORT
function DoTeleport()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(root.Position + Camera.CFrame.LookVector * tpDistance) * root.CFrame.Rotation
    root.Velocity = Vector3.zero
end

-- MOBILE BUTTONS
local freezeBtnGui, freezeBtn
local tpBtnGui, tpBtn
local awBtnGui, awBtn

local function SetupDraggable(btn)
    local dragging, dragInput, dragStart, startPos
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = btn.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    btn.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            dragInput = i
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if i == dragInput and dragging then
            local d = i.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

function CreateFreezeButton()
    if freezeBtnGui then return end
    freezeBtnGui = Instance.new("ScreenGui")
    freezeBtnGui.Name = "AstraFreezeUI"
    freezeBtnGui.ResetOnSpawn = false
    pcall(function() freezeBtnGui.Parent = GUI_PARENT end)
    if not freezeBtnGui.Parent then freezeBtnGui.Parent = LP:WaitForChild("PlayerGui") end

    freezeBtn = Instance.new("TextButton")
    freezeBtn.Size = UDim2.new(0,110,0,45)
    freezeBtn.Position = UDim2.new(0.1,0,0.4,0)
    freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
    freezeBtn.BorderColor3 = Color3.fromRGB(50,120,255)
    freezeBtn.BorderSizePixel = 2
    freezeBtn.Text = "Freeze Up"
    freezeBtn.TextColor3 = Color3.fromRGB(230,230,230)
    freezeBtn.Font = Enum.Font.SourceSansBold
    freezeBtn.TextSize = 16
    freezeBtn.ZIndex = 99999
    freezeBtn.Parent = freezeBtnGui
    Instance.new("UICorner",freezeBtn).CornerRadius = UDim.new(0,6)
    SetupDraggable(freezeBtn)

    local pressed = false
    freezeBtn.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pressed = not pressed
        if pressed then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
            freezeBtn.Text = "UNFREEZE"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(180,40,40)
            freezeBtn.BorderColor3 = Color3.fromRGB(255,50,50)
            freezeEnabled = true
        else
            freezeEnabled = false
            freezeTargetCF = nil
            freezeBtn.Text = "Freeze Up"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
            freezeBtn.BorderColor3 = Color3.fromRGB(50,120,255)
        end
    end)
end

function DestroyFreezeButton()
    if freezeBtnGui then freezeBtnGui:Destroy(); freezeBtnGui = nil; freezeBtn = nil end
    freezeEnabled = false
    freezeTargetCF = nil
end

