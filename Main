    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        Resizing = true
        ResizeStart = i.Position
        OrigSize = Main.Size
    end
end)

UIS.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    if MainDragging and not Locked then
        local d = i.Position - MainDragStart
        Main.Position = UDim2.fromOffset(MainStartPos.X.Offset + d.X, MainStartPos.Y.Offset + d.Y)
    end
    if SideDragging and not Locked then
        local d = i.Position - SideDragStart
        Side.Position = UDim2.fromOffset(SideStartPos.X.Offset + d.X, SideStartPos.Y.Offset + d.Y)
    end
    if Resizing and not Locked then
        local d = i.Position - ResizeStart
        local w = math.max(650, OrigSize.X.Offset + d.X)
        local h = math.max(400, OrigSize.Y.Offset + d.Y)
        Main.Size = UDim2.fromOffset(w,h)
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        MainDragging = false
        SideDragging = false
        Resizing = false
    end
end)

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if not MainDragging and not Resizing then CenterMain() end
    end)
end

