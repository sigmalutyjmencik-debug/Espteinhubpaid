local HueValue, Saturation, Brightness = 0,1,1
local PendingColor = ACCENT_COLOR
local PaletteDragging, HueDragging = false,false
local CurrentSetter = nil

local function UpdatePicker()
    Palette.BackgroundColor3 = Color3.fromHSV(HueValue,1,1)
    PendingColor = Color3.fromHSV(HueValue,Saturation,Brightness)
    PaletteCursor.Position = UDim2.new(Saturation,0,1-Brightness,0)
    HueCursor.Position = UDim2.new(0.5,0,HueValue,0)
    RGBLabel.Text = string.format("RGB: %d, %d, %d",
        math.floor(PendingColor.R*255+0.5),
        math.floor(PendingColor.G*255+0.5),
        math.floor(PendingColor.B*255+0.5))
end

local function LoadColor(color)
    HueValue,Saturation,Brightness = color:ToHSV()
    PendingColor = color
    UpdatePicker()
end

local function UpdatePalette(input)
    local pos = Palette.AbsolutePosition
    local size = Palette.AbsoluteSize
    Saturation = math.clamp((input.Position.X - pos.X)/size.X, 0, 1)
    Brightness = 1 - math.clamp((input.Position.Y - pos.Y)/size.Y, 0, 1)
    UpdatePicker()
end

local function UpdateHue(input)
    local pos = Hue.AbsolutePosition
    local size = Hue.AbsoluteSize
    HueValue = math.clamp((input.Position.Y - pos.Y)/size.Y, 0, 1)
    UpdatePicker()
end

Palette.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        PaletteDragging = true
        UpdatePalette(i)
    end
end)

Hue.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        HueDragging = true
        UpdateHue(i)
    end
end)

UIS.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    if PaletteDragging then UpdatePalette(i) end
    if HueDragging then UpdateHue(i) end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        PaletteDragging = false
        HueDragging = false
    end
end)

local function OpenPickerForColor(previewBtn, getColor, setColor)
    LoadColor(getColor())
    CurrentSetter = setColor
    local p = previewBtn.AbsolutePosition
    local vp = Camera.ViewportSize
    local x = p.X + 60
    local y = p.Y
    if x + 180 > vp.X then x = p.X - 180 end
    if y + 160 > vp.Y then y = vp.Y - 160 end
    Picker.Position = UDim2.fromOffset(math.max(5,x), math.max(5,y))
    Picker.Visible = true
end

ApplyButton.MouseButton1Click:Connect(function()
    if CurrentSetter then CurrentSetter(PendingColor) end
    Picker.Visible = false
end)

