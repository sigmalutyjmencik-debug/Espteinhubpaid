-- getSilentTarget
local function getSilentTarget()
    local best, bd = nil, FOV_RADIUS
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    for _,p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if TEAM_CHECK and p.Team == LP.Team then continue end
        if IsWhitelisted(p) then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local partName = HIT_PART
        if partName == "Random" then
            local opts = {"Head","Torso","HumanoidRootPart"}
            partName = opts[math.random(1, #opts)]
        end
        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head")
        if not part then continue end

        local pos, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist < bd then bd = dist; best = part end
    end
    return best
end

-- TRACER
local function CreateTracer(from, to)
    if not TRACER then return end
    if (to - from).Magnitude < 1 then return end

    local holder = Instance.new("Part")
    holder.Name = "AstraTracer"
    holder.Size = Vector3.new(0.05,0.05,0.05)
    holder.Transparency = 1
    holder.Anchored = true
    holder.CanCollide = false
    holder.CanTouch = false
    holder.CanQuery = false
    holder.Position = from
    holder.Parent = workspace

    local a0 = Instance.new("Attachment", holder)
    a0.WorldPosition = from
    local a1 = Instance.new("Attachment", holder)
    a1.WorldPosition = to

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0

    if TRACER_TYPE == "Red Laser" then
        beam.Texture = "rbxassetid://6060542021"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 3
        beam.Width0 = 1.2
        beam.Width1 = 1.2
        beam.Color = ColorSequence.new(Color3.fromRGB(255,10,10))
    else
        beam.Texture = "rbxassetid://10259604258"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 2
        beam.Width0 = 0.4
        beam.Width1 = 0.4
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150,50,220)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
        })
    end

    beam.Parent = holder
    Debris:AddItem(holder, TRACER_LIFE)
end

-- HIT MARKER
local function CreateHitmarker(worldPosition)
    if not hitMarkerEnabled then return end
    if not Drawing then return end

    local markerId = tostring(math.random(1, 100000))
    local markerData = {
        WorldPosition = worldPosition,
        Size = hitMarkerSize,
        Gap = hitMarkerGap,
        Opacity = 1,
        Lines = {}
    }

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = hitMarkerColor
        line.Thickness = 2.5
        table.insert(markerData.Lines, line)
    end

    ActiveHitmarkers[markerId] = markerData

    task.spawn(function()
        local duration = hitMarkerDuration
        if duration < 0.05 then duration = 0.05 end
        local totalSteps = 20
        local stepTime = duration / totalSteps
        for i = totalSteps, 0, -1 do
            markerData.Opacity = i / totalSteps
            task.wait(stepTime)
        end
        for _, line in ipairs(markerData.Lines) do
            pcall(function() line:Remove() end)
        end
        ActiveHitmarkers[markerId] = nil
    end)
end

RS.RenderStepped:Connect(function()
    for id, marker in pairs(ActiveHitmarkers) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(marker.WorldPosition)
        if onScreen and marker.Opacity > 0 then
            local x, y = screenPos.X, screenPos.Y
            local size = marker.Size
            local gap = marker.Gap

            marker.Lines[1].From = Vector2.new(x - gap, y - gap)
            marker.Lines[1].To = Vector2.new(x - gap - size, y - gap - size)
            marker.Lines[2].From = Vector2.new(x + gap, y - gap)
            marker.Lines[2].To = Vector2.new(x + gap + size, y - gap - size)
            marker.Lines[3].From = Vector2.new(x - gap, y + gap)
            marker.Lines[3].To = Vector2.new(x - gap - size, y + gap + size)
            marker.Lines[4].From = Vector2.new(x + gap, y + gap)
            marker.Lines[4].To = Vector2.new(x + gap + size, y + gap + size)

            for _, line in ipairs(marker.Lines) do
                line.Transparency = marker.Opacity
                line.Visible = true
            end
        else
            for _, line in ipairs(marker.Lines) do
                line.Visible = false
            end
        end
    end
end)

-- SILENT AIM (hookfunction castRays)
do
    local blaster = ReplicatedStorage:FindFirstChild("Blaster")
    local castRaysFunc = nil
    if blaster then
        local util = blaster:FindFirstChild("Utility")
        if util then
            local cr = util:FindFirstChild("castRays")
            if cr then
                local ok, f = pcall(require, cr)
                if ok and type(f) == "function" then
                    castRaysFunc = f
                end
            end
        end
    end

    if castRaysFunc and type(hookfunction) == "function" then
        pcall(function()
            local original
            original = hookfunction(castRaysFunc, function(plr, origin, dirs, ...)
                if plr == LP and SILENT_AIM and type(dirs) == "table" then
                    for k in pairs(dirs) do
                        dirs[k] = Vector3.new(0,0,-1)
                    end
                end

                local result = original(plr, origin, dirs, ...)

                if plr == LP then
                    local target = getSilentTarget()
                    if target then
                        if TRACER then
                            pcall(function() CreateTracer(origin, target.Position) end)
                        end

                        if HIT_CHANCE/100 > math.random() then
                            if type(result) == "table" then
                                if result.position then
                                    result.position = target.Position
                                    result.instance = target
                                    if target.Parent then
                                        result.taggedHumanoid = target.Parent:FindFirstChildOfClass("Humanoid")
                                    end
                                elseif result[1] and type(result[1]) == "table" then
                                    result[1].position = target.Position
                                    result[1].instance = target
                                    if target.Parent then
                                        result[1].taggedHumanoid = target.Parent:FindFirstChildOfClass("Humanoid")
                                    end
                                end
                            end

                            pcall(function() CreateHitmarker(target.Position) end)

                            if HIT_SOUND then
                                task.spawn(function()
                                    local s = Instance.new("Sound")
                                    s.SoundId = "rbxassetid://"..HIT_SOUND_ID
                                    s.Volume = HIT_SOUND_VOL
                                    s.Parent = SoundService
                                    s:Play()
                                    task.wait(2)
                                    s:Destroy()
                                end)
                            end

                            return result
                        end
                    end
                end

                return result
            end)
        end)
    end
end

-- JUMP SHOT
if type(getgc) == "function" then
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                local ok, canShoot = pcall(function() return rawget(v, "canShoot") end)
                if ok and type(canShoot) == "function" then
                    local orig = canShoot
                    v.canShoot = function(...)
                        if JUMP_SHOT then return true end
                        return orig(...)
                    end
                end
            end
        end
    end)
end

-- FOV (жёсткое удержание)
task.spawn(function()
    while true do
        RS.RenderStepped:Wait()
        if cameraFovEnabled then
            local cam = workspace.CurrentCamera
            if cam and cam.FieldOfView ~= cameraFovValue then
                cam.FieldOfView = cameraFovValue
            end
        end
    end
end)

-- SNAPLINE + FOV RENDER
RS.RenderStepped:Connect(function()
    local vp = Camera.ViewportSize
    local cx = vp.X/2
    local cy = vp.Y/2
    FOVFrame.Position = UDim2.fromOffset(cx - FOV_RADIUS, cy - FOV_RADIUS)
    FOVFrame.Size = UDim2.fromOffset(FOV_RADIUS*2, FOV_RADIUS*2)
    FOVFrame.Visible = SHOW_FOV and SILENT_AIM
    FOVStroke.Color = silentAimFovColor

    if snapLine then
        if not SILENT_AIM or not SNAPLINE then
            snapLine.Visible = false
        else
            local t = getSilentTarget()
            if not t then
                snapLine.Visible = false
            else
                local pos, onS = Camera:WorldToViewportPoint(t.Position)
                if not onS then
                    snapLine.Visible = false
                else
                    snapLine.From = Vector2.new(cx, cy)
                    snapLine.To = Vector2.new(pos.X, pos.Y)
                    snapLine.Color = silentAimSnaplineColor
                    snapLine.Visible = true
                end
            end
        end
    end
end)

-- RAPID FIRE
local function processToolForRapidFire(tool)
    if not RAPID_FIRE then return end
    if not tool or not tool:IsA("Tool") then return end
    for attrName, _ in pairs(tool:GetAttributes()) do
        if attrName:lower() == "rateoffire" then
            pcall(function()
                tool:SetAttribute(attrName, RAPID_VALUE)
            end)
        end
    end
end

local function hookCharForRapid(char)
    if not char then return end
    for _,item in ipairs(char:GetChildren()) do
        processToolForRapidFire(item)
    end
    char.ChildAdded:Connect(function(child)
        task.wait(0.05)
        processToolForRapidFire(child)
    end)
end

if LP.Character then hookCharForRapid(LP.Character) end
LP.CharacterAdded:Connect(hookCharForRapid)

task.spawn(function()
    while true do
        task.wait(0.5)
        if RAPID_FIRE and LP.Character then
            for _,item in ipairs(LP.Character:GetChildren()) do
                processToolForRapidFire(item)
            end
        end
    end
end)

-- CUSTOM HANDS
local TARGET_ARM_NAMES = {
    ["RightArm"] = true,
    ["LeftArm"] = true,
    ["SleeveL"] = true,
    ["SleeveR"] = true,
}

local function ForceHandsStyle(part)
    if not part or not part.Parent then return end
    local pbr = part:FindFirstChildOfClass("SurfaceAppearance")
    if pbr then pbr:Destroy() end
    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm and sm.TextureId ~= "" then sm.TextureId = "" end
    if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
    for _,c in ipairs(part:GetChildren()) do
        if c:IsA("Texture") or c:IsA("Decal") or c:IsA("Clothing") then
            c:Destroy()
        end
    end
    part.Color = customHandsColor
    part.Transparency = customHandsTransp
    part.Material = Enum.Material.Neon
    pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
end

local function BindArm(part)
    if activeLockedArms[part] then return end
    activeLockedArms[part] = true
    ForceHandsStyle(part)
    local busy = false
    part.Changed:Connect(function(prop)
        if busy or not part.Parent or not customHandsEnabled then return end
        if prop == "Color" or prop == "Transparency" or prop == "Material" or prop == "LocalTransparencyModifier" then
            busy = true
            part.Color = customHandsColor
            part.Transparency = customHandsTransp
            part.Material = Enum.Material.Neon
            pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
            busy = false
        end
    end)
end

function SetupCustomHands()
    for _,obj in ipairs(game:GetDescendants()) do
        if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
            BindArm(obj)
        end
    end
end

function RemoveCustomHands()
    activeLockedArms = {}
end

game.DescendantAdded:Connect(function(d)
    if customHandsEnabled and d:IsA("BasePart") and TARGET_ARM_NAMES[d.Name] then
        task.wait()
        BindArm(d)
    end
end)

task.spawn(function()
    while true do
        task.wait(1.5)
        if customHandsEnabled then
            pcall(function()
                for _,obj in ipairs(game:GetDescendants()) do
                    if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
                        BindArm(obj)
                    end
                end
            end)
        end
    end
end)

LP.CharacterAdded:Connect(function()
    activeLockedArms = {}
    if customHandsEnabled then
        task.wait(0.5)
        SetupCustomHands()
    end
end)

-- VIEW MODEL
function UpdateViewModel()
    if not viewModelEnabled then return end
    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local toolWorld = workspace:FindFirstChild(tool.Name)
    if not toolWorld then return end
    pcall(function()
        toolWorld:PivotTo(Camera.CFrame * CFrame.new(viewModelX, viewModelY, viewModelZ))
    end)
end

function ApplyViewModel()
    if viewModelConn then viewModelConn:Disconnect(); viewModelConn = nil end
    viewModelConn = RS.RenderStepped:Connect(function()
        if not viewModelEnabled then return end
        local char = LP.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        local toolWorld = workspace:FindFirstChild(tool.Name)
        if not toolWorld then return end
        pcall(function()
            toolWorld:PivotTo(Camera.CFrame * CFrame.new(viewModelX, viewModelY, viewModelZ))
        end)
    end)
end

function RemoveViewModel()
    if viewModelConn then viewModelConn:Disconnect(); viewModelConn = nil end
end

-- SKYBOX
function ApplySkybox(name)
    if activeSky then activeSky:Destroy(); activeSky = nil end
    if name == "None" then return end

    for _,o in ipairs(Lighting:GetChildren()) do
        if o:IsA("Sky") or o:IsA("Atmosphere") or o:IsA("ColorCorrectionEffect") then
            o:Destroy()
        end
    end

    local s = Instance.new("Sky")

    if name == "Galaxy" then
        s.SkyboxFt = "rbxassetid://99674108178510"
        s.SkyboxBk = "rbxassetid://76898653037615"
        s.SkyboxLf = "rbxassetid://78775818685659"
        s.SkyboxRt = "rbxassetid://117864739442861"
        s.SkyboxUp = "rbxassetid://94326041205929"
        s.SkyboxDn = "rbxassetid://134726625576772"
        s.CelestialBodiesShown = false
        s.SunTextureId = ""
        s.MoonTextureId = ""
        Lighting.ClockTime = 12
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.fromRGB(128,128,128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
        Lighting.ColorShift_Top = Color3.fromRGB(0,0,0)
    else
        local id = SKYBOXES[name]
        if id then
            s.SkyboxBk = id; s.SkyboxDn = id; s.SkyboxFt = id
            s.SkyboxLf = id; s.SkyboxRt = id; s.SkyboxUp = id
        end
    end

    s.Parent = Lighting
    activeSky = s
end

-- ESP
local function createESP(player)
    if espCache[player] then return end
    if not Drawing then return end
    local o = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        HPBar = Drawing.new("Square"),
        HPBg = Drawing.new("Square"),
        Dist = Drawing.new("Text"),
        Weapon = Drawing.new("Text"),
    }
    o.Box.Filled = false
    o.Box.Thickness = 1.5
    o.Name.Size = 14; o.Name.Center = true; o.Name.Outline = true
    o.HPBg.Filled = true; o.HPBg.Color = Color3.fromRGB(40,40,40)
    o.HPBar.Filled = true
    o.Dist.Size = 12; o.Dist.Center = true; o.Dist.Outline = true
    o.Weapon.Size = 12; o.Weapon.Center = true; o.Weapon.Outline = true
    for _,d in pairs(o) do d.Visible = false end
    espCache[player] = o
end

local function removeESP(player)
    if espCache[player] then
        for _,d in pairs(espCache[player]) do pcall(function() d:Remove() end) end
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(function(p) if p ~= LP then createESP(p) end end)
Players.PlayerRemoving:Connect(removeESP)
for _,p in ipairs(Players:GetPlayers()) do if p ~= LP then createESP(p) end end

local function getEquippedWeapon(char)
    local tool = char:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Fists"
end

RS.RenderStepped:Connect(function()
    for player, o in pairs(espCache) do
        local char = player.Character
        local visible = espEnabled and not IsWhitelisted(player)

        if visible and char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if root and head and hum and hum.Health > 0 then
                local headPos, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                local legPos, on2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

                if on1 and on2 then
                    local boxH = math.abs(headPos.Y - legPos.Y)
                    local boxW = boxH / 1.6
                    local bx = headPos.X - boxW/2
                    local by = headPos.Y

                    if espBox then
                        o.Box.Size = Vector2.new(boxW, boxH)
                        o.Box.Position = Vector2.new(bx, by)
                        o.Box.Color = espBoxColor
                        o.Box.Visible = true
                    else o.Box.Visible = false end

                    if espName then
                        o.Name.Text = player.Name
                        o.Name.Position = Vector2.new(headPos.X, by - 16)
                        o.Name.Color = espNameColor
                        o.Name.Visible = true
                    else o.Name.Visible = false end

                    if espHealth then
                        local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        local barH = boxH * hp
                        o.HPBg.Size = Vector2.new(4, boxH)
                        o.HPBg.Position = Vector2.new(bx - 6, by)
                        o.HPBg.Visible = true
                        o.HPBar.Size = Vector2.new(4, barH)
                        o.HPBar.Position = Vector2.new(bx - 6, by + (boxH - barH))
                        o.HPBar.Color = Color3.fromHSV(hp * 0.33, 1, 1)
                        o.HPBar.Visible = true
                    else
                        o.HPBg.Visible = false
                        o.HPBar.Visible = false
                    end

                    if espDistance then
                        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        local d = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                        o.Dist.Text = d .. " studs"
                        o.Dist.Position = Vector2.new(headPos.X, legPos.Y + 4)
                        o.Dist.Color = espDistColor
                        o.Dist.Visible = true
                    else o.Dist.Visible = false end

                    if espWeapon then
                        o.Weapon.Text = getEquippedWeapon(char)
                        o.Weapon.Position = Vector2.new(headPos.X, legPos.Y + 18)
                        o.Weapon.Color = espWeapColor
                        o.Weapon.Visible = true
                    else o.Weapon.Visible = false end
                else
                    for _,d in pairs(o) do d.Visible = false end
                end
            else
                for _,d in pairs(o) do d.Visible = false end
            end
        else
            for _,d in pairs(o) do d.Visible = false end
        end
    end
end)

-- MAIN HEARTBEAT
local wasInAirBhop = false

RS.Heartbeat:Connect(function(dt)
    if noFogEnabled and Lighting.FogEnd ~= 1e6 then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e5
    end
    if fullbrightEnabled then
        if Lighting.Brightness ~= 3 then Lighting.Brightness = 3 end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
    end

    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if noClipEnabled then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if speedHackEnabled and hum.WalkSpeed ~= speedValue then
        hum.WalkSpeed = speedValue
    end

    if bigJumpEnabled then
        hum.UseJumpPower = true
        if hum.JumpPower ~= bigJumpPower then hum.JumpPower = bigJumpPower end
    end

    if flyEnabled then
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
        root.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.zero
        hum.PlatformStand = true
    elseif hum.PlatformStand and not freezeEnabled and not airWalkBusy then
        hum.PlatformStand = false
    end

    if freezeEnabled and UIS:IsKeyDown(keybinds.Freeze) then
        if not freezeTargetCF then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
        end
        root.CFrame = freezeTargetCF
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        hum.PlatformStand = true
    elseif freezeTargetCF then
        freezeTargetCF = nil
        hum.PlatformStand = false
    end

    if bhopEnabled then
        local state = hum:GetState()
        local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        if not inAir and wasInAirBhop then
            hum.Jump = true
        end
        wasInAirBhop = inAir
    end

    if gunChamsEnabled then
        for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _,p in ipairs(tool:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Color = gunChamsColor
                        p.Material = Enum.Material.Neon
                    end
                end
            end
        end
    end
end)

UIS.JumpRequest:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if infJumpEnabled then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

function DoAirWalk()
    if airWalkBusy then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    airWalkBusy = true

    local targetY = root.Position.Y + airWalkHeight
    root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z) * root.CFrame.Rotation

    local bodyPos = Instance.new("BodyPosition")
    bodyPos.MaxForce = Vector3.new(0, math.huge, 0)
    bodyPos.Position = Vector3.new(0, targetY, 0)
    bodyPos.P = 25000
    bodyPos.Parent = root

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, 0, math.huge)
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    hum:ChangeState(Enum.HumanoidStateType.Running)

    task.wait(airWalkDuration)

    if bodyPos then bodyPos:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end

    local currentPos = root.Position
    root.CFrame = CFrame.new(currentPos.X, currentPos.Y - airWalkHeight, currentPos.Z) * root.CFrame.Rotation
    root.Velocity = Vector3.zero
    root.AssemblyLinearVelocity = Vector3.zero
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)

    airWalkBusy = false
end

function DoTeleport()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(root.Position + Camera.CFrame.LookVector * tpDistance) * root.CFrame.Rotation
    root.Velocity = Vector3.zero
end

local freezeBtnGui, freezeBtn
local tpBtnGui, tpBtn
local awBtnGui, awBtn

local function SetupDraggable(btn)
    local dragging, dragInput, dragStart, startPos
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = btn.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    btn.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            dragInput = i
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if i == dragInput and dragging then
            local d = i.Position - dragStart
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

function CreateFreezeButton()
    if freezeBtnGui then return end
    freezeBtnGui = Instance.new("ScreenGui")
    freezeBtnGui.Name = "AstraFreezeUI"
    freezeBtnGui.ResetOnSpawn = false
    pcall(function() freezeBtnGui.Parent = GUI_PARENT end)
    if not freezeBtnGui.Parent then freezeBtnGui.Parent = LP:WaitForChild("PlayerGui") end

    freezeBtn = Instance.new("TextButton")
    freezeBtn.Size = UDim2.new(0,110,0,45)
    freezeBtn.Position = UDim2.new(0.1,0,0.4,0)
    freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
    freezeBtn.BorderColor3 = Color3.fromRGB(255,80,180)
    freezeBtn.BorderSizePixel = 2
    freezeBtn.Text = "Freeze Up"
    freezeBtn.TextColor3 = Color3.fromRGB(230,230,230)
    freezeBtn.Font = Enum.Font.SourceSansBold
    freezeBtn.TextSize = 16
    freezeBtn.ZIndex = 99999
    freezeBtn.Parent = freezeBtnGui
    Instance.new("UICorner",freezeBtn).CornerRadius = UDim.new(0,6)
    SetupDraggable(freezeBtn)

    local pressed = false
    freezeBtn.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pressed = not pressed
        if pressed then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
            freezeBtn.Text = "UNFREEZE"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(180,40,80)
            freezeBtn.BorderColor3 = Color3.fromRGB(255,50,120)
            freezeEnabled = true
        else
            freezeEnabled = false
            freezeTargetCF = nil
            freezeBtn.Text = "Freeze Up"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
            freezeBtn.BorderColor3 = Color3.fromRGB(255,80,180)
        end
    end)
end

function DestroyFreezeButton()
    if freezeBtnGui then freezeBtnGui:Destroy(); freezeBtnGui = nil; freezeBtn = nil end
    freezeEnabled = false
    freezeTargetCF = nil
end

function CreateTPButton()
    if tpBtnGui then return end
    tpBtnGui = Instance.new("ScreenGui")
    tpBtnGui.Name = "AstraTPButton"
    tpBtnGui.ResetOnSpawn = false
    pcall(function() tpBtnGui.Parent = GUI_PARENT end)
    if not tpBtnGui.Parent then tpBtnGui.Parent = LP:WaitForChild("PlayerGui") end

    tpBtn = Instance.new("TextButton")
    tpBtn.Size = UDim2.new(0,110,0,45)
    tpBtn.Position = UDim2.new(0.1,0,0.5,0)
    tpBtn.BackgroundColor3 = Color3.fromRGB(25,30,40)
    tpBtn.BorderColor3 = Color3.fromRGB(255,80,180)
    tpBtn.BorderSizePixel = 2
    tpBtn.Text = "TP "..tpDistance.." Studs"
    tpBtn.TextColor3 = Color3.fromRGB(240,240,240)
    tpBtn.Font = Enum.Font.Code
    tpBtn.TextSize = 14
    tpBtn.ZIndex = 99999
    tpBtn.Parent = tpBtnGui
    Instance.new("UICorner",tpBtn).CornerRadius = UDim.new(0,5)
    SetupDraggable(tpBtn)

    tpBtn.MouseButton1Click:Connect(function() DoTeleport() end)
end

function DestroyTPButton()
    if tpBtnGui then tpBtnGui:Destroy(); tpBtnGui = nil; tpBtn = nil end
end

function CreateAirWalkButton()
    if awBtnGui then return end
    awBtnGui = Instance.new("ScreenGui")
    awBtnGui.Name = "AstraAirWalkButton"
    awBtnGui.ResetOnSpawn = false
    pcall(function() awBtnGui.Parent = GUI_PARENT end)
    if not awBtnGui.Parent then awBtnGui.Parent = LP:WaitForChild("PlayerGui") end

    awBtn = Instance.new("TextButton")
    awBtn.Size = UDim2.new(0,130,0,45)
    awBtn.Position = UDim2.new(0.1,0,0.5,0)
    awBtn.BackgroundColor3 = Color3.fromRGB(25,30,40)
    awBtn.BorderColor3 = Color3.fromRGB(255,80,180)
    awBtn.BorderSizePixel = 2
    awBtn.Text = "Air Walk"
    awBtn.TextColor3 = Color3.fromRGB(240,240,240)
    awBtn.Font = Enum.Font.Code
    awBtn.TextSize = 13
    awBtn.ZIndex = 99999
    awBtn.Parent = awBtnGui
    Instance.new("UICorner",awBtn).CornerRadius = UDim.new(0,6)
    SetupDraggable(awBtn)

    awBtn.MouseButton1Click:Connect(function() DoAirWalk() end)
end

function DestroyAirWalkButton()
    if awBtnGui then awBtnGui:Destroy(); awBtnGui = nil; awBtn = nil end
end

UIS.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == airWalkKey then DoAirWalk() end
    if inp.KeyCode == tpKey then DoTeleport() end
end)

task.defer(function() CenterMain() end)
