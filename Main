local cfgPath = "ProjectAstra_Config.json"

local function CollectConfig()
    return {
        silentAimEnabled = silentAimEnabled,
        silentAimFov = silentAimFov,
        silentAimPart = silentAimPart,
        silentAimTeamCheck = silentAimTeamCheck,
        silentAimVisCheck = silentAimVisCheck,
        silentAimShowFov = silentAimShowFov,
        silentAimSnapline = silentAimSnapline,
        silentAimFovColor = {silentAimFovColor.R,silentAimFovColor.G,silentAimFovColor.B},
        silentAimSnaplineColor = {silentAimSnaplineColor.R,silentAimSnaplineColor.G,silentAimSnaplineColor.B},
        bulletTracerEnabled = bulletTracerEnabled,
        bulletTracerType = bulletTracerType,
        bulletTracerLife = bulletTracerLife,
        hitSoundEnabled = hitSoundEnabled,
        hitSoundId = hitSoundId,
        hitSoundVolume = hitSoundVolume,
        hitMarkerEnabled = hitMarkerEnabled,
        hitMarkerColor = {hitMarkerColor.R,hitMarkerColor.G,hitMarkerColor.B},
        hitMarkerSize = hitMarkerSize,
        jumpShotEnabled = jumpShotEnabled,
        rapidFireEnabled = rapidFireEnabled,
        rapidFireValue = rapidFireValue,
        cameraFovEnabled = cameraFovEnabled,
        cameraFovValue = cameraFovValue,
        noFogEnabled = noFogEnabled,
        fullbrightEnabled = fullbrightEnabled,
        espEnabled = espEnabled,
        espBox = espBox, espName = espName, espHealth = espHealth,
        espDistance = espDistance, espWeapon = espWeapon,
        espBoxColor = {espBoxColor.R,espBoxColor.G,espBoxColor.B},
        espNameColor = {espNameColor.R,espNameColor.G,espNameColor.B},
        espDistColor = {espDistColor.R,espDistColor.G,espDistColor.B},
        espWeapColor = {espWeapColor.R,espWeapColor.G,espWeapColor.B},
        customHandsEnabled = customHandsEnabled,
        customHandsColor = {customHandsColor.R,customHandsColor.G,customHandsColor.B},
        customHandsTransp = customHandsTransp,
        skyboxEnabled = skyboxEnabled,
        skyboxMode = skyboxMode,
        speedHackEnabled = speedHackEnabled,
        speedValue = speedValue,
        infJumpEnabled = infJumpEnabled,
        noJumpCooldown = noJumpCooldown,
        bigJumpEnabled = bigJumpEnabled,
        bigJumpPower = bigJumpPower,
        noClipEnabled = noClipEnabled,
        bhopEnabled = bhopEnabled,
        flyEnabled = flyEnabled,
        flySpeed = flySpeed,
        gunChamsEnabled = gunChamsEnabled,
        gunChamsColor = {gunChamsColor.R,gunChamsColor.G,gunChamsColor.B},
        borderColor = {BORDER_COLOR.R,BORDER_COLOR.G,BORDER_COLOR.B},
        accentColor = {ACCENT_COLOR.R,ACCENT_COLOR.G,ACCENT_COLOR.B},
    }
end

local function ApplyConfig(cfg)
    if not cfg then return end
    silentAimEnabled = cfg.silentAimEnabled or silentAimEnabled
    silentAimFov = cfg.silentAimFov or silentAimFov
    silentAimPart = cfg.silentAimPart or silentAimPart
    silentAimTeamCheck = cfg.silentAimTeamCheck or silentAimTeamCheck
    silentAimVisCheck = cfg.silentAimVisCheck or silentAimVisCheck
    silentAimShowFov = cfg.silentAimShowFov ~= nil and cfg.silentAimShowFov or silentAimShowFov
    silentAimSnapline = cfg.silentAimSnapline ~= nil and cfg.silentAimSnapline or silentAimSnapline
    if cfg.silentAimFovColor then silentAimFovColor = Color3.new(unpack(cfg.silentAimFovColor)) end
    if cfg.silentAimSnaplineColor then silentAimSnaplineColor = Color3.new(unpack(cfg.silentAimSnaplineColor)) end
    bulletTracerEnabled = cfg.bulletTracerEnabled ~= nil and cfg.bulletTracerEnabled or bulletTracerEnabled
    bulletTracerType = cfg.bulletTracerType or bulletTracerType
    bulletTracerLife = cfg.bulletTracerLife or bulletTracerLife
    hitSoundEnabled = cfg.hitSoundEnabled or hitSoundEnabled
    hitSoundId = cfg.hitSoundId or hitSoundId
    hitSoundVolume = cfg.hitSoundVolume or hitSoundVolume
    hitMarkerEnabled = cfg.hitMarkerEnabled ~= nil and cfg.hitMarkerEnabled or hitMarkerEnabled
    if cfg.hitMarkerColor then hitMarkerColor = Color3.new(unpack(cfg.hitMarkerColor)) end
    hitMarkerSize = cfg.hitMarkerSize or hitMarkerSize
    jumpShotEnabled = cfg.jumpShotEnabled or jumpShotEnabled
    rapidFireEnabled = cfg.rapidFireEnabled or rapidFireEnabled
    rapidFireValue = cfg.rapidFireValue or rapidFireValue
    cameraFovEnabled = cfg.cameraFovEnabled or cameraFovEnabled
    cameraFovValue = cfg.cameraFovValue or cameraFovValue
    noFogEnabled = cfg.noFogEnabled or noFogEnabled
    fullbrightEnabled = cfg.fullbrightEnabled or fullbrightEnabled
    espEnabled = cfg.espEnabled or espEnabled
    espBox = cfg.espBox ~= nil and cfg.espBox or espBox
    espName = cfg.espName ~= nil and cfg.espName or espName
    espHealth = cfg.espHealth ~= nil and cfg.espHealth or espHealth
    espDistance = cfg.espDistance ~= nil and cfg.espDistance or espDistance
    espWeapon = cfg.espWeapon ~= nil and cfg.espWeapon or espWeapon
    if cfg.espBoxColor then espBoxColor = Color3.new(unpack(cfg.espBoxColor)) end
    if cfg.espNameColor then espNameColor = Color3.new(unpack(cfg.espNameColor)) end
    if cfg.espDistColor then espDistColor = Color3.new(unpack(cfg.espDistColor)) end
    if cfg.espWeapColor then espWeapColor = Color3.new(unpack(cfg.espWeapColor)) end
    customHandsEnabled = cfg.customHandsEnabled or customHandsEnabled
    if cfg.customHandsColor then customHandsColor = Color3.new(unpack(cfg.customHandsColor)) end
    customHandsTransp = cfg.customHandsTransp or customHandsTransp
    skyboxEnabled = cfg.skyboxEnabled or skyboxEnabled
    skyboxMode = cfg.skyboxMode or skyboxMode
    speedHackEnabled = cfg.speedHackEnabled or speedHackEnabled
    speedValue = cfg.speedValue or speedValue
    infJumpEnabled = cfg.infJumpEnabled or infJumpEnabled
    noJumpCooldown = cfg.noJumpCooldown or noJumpCooldown
    bigJumpEnabled = cfg.bigJumpEnabled or bigJumpEnabled
    bigJumpPower = cfg.bigJumpPower or bigJumpPower
    noClipEnabled = cfg.noClipEnabled or noClipEnabled
    bhopEnabled = cfg.bhopEnabled or bhopEnabled
    flyEnabled = cfg.flyEnabled or flyEnabled
    flySpeed = cfg.flySpeed or flySpeed
    gunChamsEnabled = cfg.gunChamsEnabled or gunChamsEnabled
    if cfg.gunChamsColor then gunChamsColor = Color3.new(unpack(cfg.gunChamsColor)) end
    if cfg.borderColor then SetBorderColor(Color3.new(unpack(cfg.borderColor))) end
    if cfg.accentColor then SetAccentColor(Color3.new(unpack(cfg.accentColor))) end
    if customHandsEnabled then SetupCustomHands() else RemoveCustomHands() end
    if skyboxEnabled then ApplySkybox(skyboxMode) end
end

ButtonRow(SetScroll, "Save Config (JSON)", function()
    pcall(function()
        if writefile then
            writefile(cfgPath, HttpService:JSONEncode(CollectConfig()))
        end
    end)
end, sY); sY = sY + 30

