    local SoundService = game:GetService("SoundService")
    local HttpService = game:GetService("HttpService")

    local LP = Players.LocalPlayer
    local Camera = workspace.CurrentCamera
    local GUI_PARENT

    pcall(function() GUI_PARENT = game:GetService("CoreGui") end)
    if not GUI_PARENT then
        GUI_PARENT = LP:WaitForChild("PlayerGui")
    end

    A.UIS = UIS
    A.Players = Players
    A.Lighting = Lighting
    A.RS = RS
    A.Debris = Debris
    A.SoundService = SoundService
    A.ReplicatedStorage = ReplicatedStorage
    A.HttpService = HttpService
    A.LP = LP
    A.Camera = Camera
    A.GUI_PARENT = GUI_PARENT

    for _, n in ipairs({"ProjectAstra","AstraFOV","AstraFreezeUI","AstraTPButton","AstraAirWalkButton","AstraColorPicker"}) do
        local old = GUI_PARENT:FindFirstChild(n)
        if old then old:Destroy() end
    end

    A.BG = Color3.fromRGB(20,20,24)
    A.PANEL = Color3.fromRGB(24,24,29)
    A.DROPBG = Color3.fromRGB(22,22,27)
    A.BARBG = Color3.fromRGB(28,28,34)
    A.CHECKBG = Color3.fromRGB(26,26,31)
    A.WHITE = Color3.fromRGB(235,235,235)
    A.GRAY = Color3.fromRGB(145,145,150)
    A.ACCENT = Color3.fromRGB(255,25,120)

    -- SETTINGS
    A.SILENT_AIM = false
    A.HIT_CHANCE = 95
    A.HIT_PART = "Head"
    A.FOV_RADIUS = 200
    A.SHOW_FOV = true
    A.TEAM_CHECK = false
    A.SNAPLINE = false
    A.TRACER = false
    A.TRACER_TYPE = "Red Laser"
    A.TRACER_LIFE = 3
    A.RAPID_FIRE = false
    A.RAPID_VALUE = 10000000
    A.HIT_SOUND = false
    A.HIT_SOUND_ID = "121566025787365"
    A.HIT_SOUND_VOL = 1
    A.silentAimFovColor = Color3.fromRGB(255,80,180)
    A.silentAimSnaplineColor = Color3.fromRGB(255,0,255)
    A.hitMarkerEnabled = true
