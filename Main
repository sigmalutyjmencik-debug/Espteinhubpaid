local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ProjectAstra"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = GUI_PARENT

local Main = Instance.new("Frame")
Main.Name = "Main"
Main.Size = UDim2.fromOffset(944,593)
Main.BackgroundColor3 = BG
Main.BorderSizePixel = 0
Main.ClipsDescendants = true
Main.Parent = ScreenGui

local MainScale = Instance.new("UIScale")
MainScale.Scale = 0.55
MainScale.Parent = Main

local function CenterMain()
    local vp = Camera.ViewportSize
    local scale = MainScale.Scale
    local w = Main.Size.X.Offset * scale
    local h = Main.Size.Y.Offset * scale
    Main.Position = UDim2.fromOffset((vp.X-w)/2,(vp.Y-h)/2)
end
CenterMain()

local Stroke = function(parent, thickness)
    local s = Instance.new("UIStroke")
    s.Color = ACCENT
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end
Stroke(Main, 1.5)

local MakeText = function(parent, value, pos, size, ts, col)
    local l = Instance.new("TextLabel")
    l.Position = pos
    l.Size = size
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Text = value
    l.TextColor3 = col or WHITE
    l.Font = Enum.Font.Code
    l.TextSize = ts or 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Parent = parent
    return l
end

