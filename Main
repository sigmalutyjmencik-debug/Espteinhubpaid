--========================================================--
-- DRAG / RESIZE
--========================================================--

local MainDragging, MainDragStart, MainStartPos = false,nil,nil
TitleBar.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        MainDragging = true
        MainDragStart = i.Position
        MainStartPos = Main.Position
    end
end)

local SideDragging, SideDragStart, SideStartPos = false,nil,nil
Side.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        SideDragging = true
        SideDragStart = i.Position
        SideStartPos = Side.Position
    end
end)

local ResizeHandle = Instance.new("TextButton")
ResizeHandle.AnchorPoint = Vector2.new(1,1)
ResizeHandle.Position = UDim2.fromScale(1,1)
ResizeHandle.Size = UDim2.fromOffset(20,20)
ResizeHandle.BackgroundColor3 = BG
ResizeHandle.BorderSizePixel = 0
ResizeHandle.Text = "◢"
ResizeHandle.TextColor3 = ACCENT_COLOR
ResizeHandle.Font = Enum.Font.Code
ResizeHandle.TextSize = 15
ResizeHandle.AutoButtonColor = false
ResizeHandle.ZIndex = 1000
ResizeHandle.Parent = Main
RegisterAccent(ResizeHandle,"TextColor3")

local Resizing, ResizeStart, OrigSize = false,nil,nil
ResizeHandle.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        Resizing = true
        ResizeStart = i.Position
        OrigSize = Main.Size
    end
end)

UIS.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    if MainDragging and not Locked then
        local d = i.Position - MainDragStart
        Main.Position = UDim2.fromOffset(MainStartPos.X.Offset + d.X, MainStartPos.Y.Offset + d.Y)
    end
    if SideDragging and not Locked then
        local d = i.Position - SideDragStart
        Side.Position = UDim2.fromOffset(SideStartPos.X.Offset + d.X, SideStartPos.Y.Offset + d.Y)
    end
    if Resizing and not Locked then
        local d = i.Position - ResizeStart
        local w = math.max(650, OrigSize.X.Offset + d.X)
        local h = math.max(400, OrigSize.Y.Offset + d.Y)
        Main.Size = UDim2.fromOffset(w,h)
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        MainDragging = false
        SideDragging = false
        Resizing = false
    end
end)

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if not MainDragging and not Resizing then CenterMain() end
    end)
end

--========================================================--
-- CUSTOM HANDS
--========================================================--

local TARGET_ARM_NAMES = {
    ["RightArm"] = true,
    ["LeftArm"] = true,
    ["SleeveL"] = true,
    ["SleeveR"] = true,
}

local function ForceHandsStyle(part)
    if not part or not part.Parent then return end
    local pbr = part:FindFirstChildOfClass("SurfaceAppearance")
    if pbr then pbr:Destroy() end
    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm and sm.TextureId ~= "" then sm.TextureId = "" end
    if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
    for _,c in ipairs(part:GetChildren()) do
        if c:IsA("Texture") or c:IsA("Decal") or c:IsA("Clothing") then
            c:Destroy()
        end
    end
    part.Color = customHandsColor
    part.Transparency = customHandsTransp
    part.Material = Enum.Material.Neon
    pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
end

local function BindArm(part)
    if activeLockedArms[part] then return end
    activeLockedArms[part] = true
    ForceHandsStyle(part)
    local busy = false
    part.Changed:Connect(function(prop)
        if busy or not part.Parent or not customHandsEnabled then return end
        if prop == "Color" or prop == "Transparency" or prop == "Material" or prop == "LocalTransparencyModifier" then
            busy = true
            part.Color = customHandsColor
            part.Transparency = customHandsTransp
            part.Material = Enum.Material.Neon
            pcall(function() part.LocalTransparencyModifier = customHandsTransp end)
            busy = false
        end
    end)
end

function SetupCustomHands()
    for _,obj in ipairs(game:GetDescendants()) do
        if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
            BindArm(obj)
        end
    end
end

function RemoveCustomHands()
    activeLockedArms = {}
end

game.DescendantAdded:Connect(function(d)
    if customHandsEnabled and d:IsA("BasePart") and TARGET_ARM_NAMES[d.Name] then
        task.wait()
        BindArm(d)
    end
end)

task.spawn(function()
    while true do
        task.wait(1.5)
        if customHandsEnabled then
            pcall(function()
                for _,obj in ipairs(game:GetDescendants()) do
                    if obj:IsA("BasePart") and TARGET_ARM_NAMES[obj.Name] then
                        BindArm(obj)
                    end
                end
            end)
        end
    end
end)

LP.CharacterAdded:Connect(function()
    activeLockedArms = {}
    if customHandsEnabled then
        task.wait(0.5)
        SetupCustomHands()
    end
end)

--========================================================--
-- SKYBOX
--========================================================--

function ApplySkybox(name)
    if activeSky then activeSky:Destroy(); activeSky = nil end
    if name == "None" then return end

    for _,o in ipairs(Lighting:GetChildren()) do
        if o:IsA("Sky") then o:Destroy() end
    end

    local s = Instance.new("Sky")

    if name == "Gothbreach" then
        s.SkyboxFt = "rbxassetid://99674108178510"
        s.SkyboxBk = "rbxassetid://76898653037615"
        s.SkyboxLf = "rbxassetid://78775818685659"
        s.SkyboxRt = "rbxassetid://117864739442861"
        s.SkyboxUp = "rbxassetid://94326041205929"
        s.SkyboxDn = "rbxassetid://134726625576772"
        s.CelestialBodiesShown = false
        s.SunTextureId = ""
        s.MoonTextureId = ""
        Lighting.ClockTime = 12
        Lighting.Brightness = 1
        Lighting.Ambient = Color3.fromRGB(128,128,128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
        Lighting.ColorShift_Top = Color3.fromRGB(0,0,0)
    elseif name == "Epstein" then
        local id = "rbxassetid://159454299"
        s.SkyboxBk = id; s.SkyboxDn = id; s.SkyboxFt = id
        s.SkyboxLf = id; s.SkyboxRt = id; s.SkyboxUp = id
    else
        local id = SKYBOXES[name]
        if id then
            s.SkyboxBk = id; s.SkyboxDn = id; s.SkyboxFt = id
            s.SkyboxLf = id; s.SkyboxRt = id; s.SkyboxUp = id
        end
    end

    s.Parent = Lighting
    activeSky = s
end

--========================================================--
-- DAMAGE TRACKING
--========================================================--

local damageEvents = {}
local DAMAGE_WINDOW = 0.35

local function watchHumanoid(plr)
    local function hook(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local last = hum.Health
        hum.HealthChanged:Connect(function(h)
            if h < last then
                damageEvents[plr] = tick()
            end
            last = h
        end)
    end
    if plr.Character then hook(plr.Character) end
    plr.CharacterAdded:Connect(hook)
end

for _,p in ipairs(Players:GetPlayers()) do
    if p ~= LP then watchHumanoid(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LP then watchHumanoid(p) end
end)

local function wasDamagedRecently(plr)
    if not plr then return false end
    local t = damageEvents[plr]
    return t and (tick() - t) <= DAMAGE_WINDOW
end

--========================================================--
-- BULLET EFFECTS
--========================================================--

local function CreateLaserTracer(from, to)
    if not bulletTracerEnabled then return end
    local dist = (to - from).Magnitude
    if dist < 0.1 then return end
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = bulletTracerColor
    part.Size = Vector3.new(0.15, 0.15, dist)
    part.CFrame = CFrame.new(from, to) * CFrame.new(0,0,-dist/2)
    part.Parent = workspace
    task.delay(bulletTracerLife, function()
        if part and part.Parent then part:Destroy() end
    end)
end

local function CreateHitmarker(pos3D)
    if not bulletMarkerEnabled then return end
    local vp, onScreen = Camera:WorldToViewportPoint(pos3D)
    if not onScreen then return end

    local marker = Instance.new("Frame")
    marker.AnchorPoint = Vector2.new(0.5,0.5)
    marker.Position = UDim2.fromOffset(vp.X, vp.Y)
    marker.Size = UDim2.fromOffset(bulletMarkerSize*2, bulletMarkerSize*2)
    marker.BackgroundTransparency = 1
    marker.Parent = ScreenGui

    for i=1,4 do
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5,0.5)
        line.Size = UDim2.fromOffset(2, bulletMarkerSize)
        line.BackgroundColor3 = bulletMarkerColor
        line.BorderSizePixel = 0
        local offset = 8
        if i == 1 then line.Position = UDim2.new(0.5,0,0.5,-offset)
        elseif i == 2 then line.Position = UDim2.new(0.5,offset,0.5,0); line.Rotation = 90
        elseif i == 3 then line.Position = UDim2.new(0.5,0,0.5,offset)
        elseif i == 4 then line.Position = UDim2.new(0.5,-offset,0.5,0); line.Rotation = 90
        end
        line.Parent = marker
    end

    task.delay(0.35, function()
        if marker and marker.Parent then marker:Destroy() end
    end)
end

local function PlayHitSound()
    if not hitSoundEnabled then return end
    local s = Instance.new("Sound")
    s.SoundId = hitSoundId
    s.Volume = hitSoundVolume
    s.Parent = LP:FindFirstChild("PlayerGui") or LP
    s:Play()
    task.delay(2, function() if s then s:Destroy() end end)
end

--========================================================--
-- SILENT AIM target finder
--========================================================--

local function getSilentTarget()
    local best, bd = nil, silentAimFov
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    for _,p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if silentAimTeamCheck and p.Team == LP.Team then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(silentAimPart) or char:FindFirstChild("Head")
        if not part then continue end
        if silentAimVisCheck then
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {LP.Character, Camera}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local ray = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000, rp)
            if not ray or not ray.Instance or not ray.Instance:IsDescendantOf(char) then continue end
        end
        local pos, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist < bd then bd = dist; best = part end
    end
    return best
end

--========================================================--
-- SILENT AIM hook через hookmetamethod (Delta-safe)
--========================================================--

local mt = getrawmetatable(game)
if mt then
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if silentAimEnabled and (method == "FireServer" or method == "InvokeServer") then
            local target = getSilentTarget()
            if target then
                -- подменяем позицию на цель
                for i,v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = target.Position
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.new(target.Position)
                    end
                end
            end
        end

        return oldNamecall(self, unpack(args))
    end)
    setreadonly(mt, true)
end

--========================================================--
-- RAPID FIRE + HIT EFFECTS
--========================================================--

UIS.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    if rapidFireEnabled then
        task.spawn(function()
            while rapidFireEnabled and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
                local t = silentAimEnabled and getSilentTarget() or nil
                if t then
                    CreateLaserTracer(Camera.CFrame.Position, t.Position)
                    local plr = Players:GetPlayerFromCharacter(t.Parent)
                    if plr and wasDamagedRecently(plr) then
                        CreateHitmarker(t.Position)
                        PlayHitSound()
                    end
                end
                task.wait(rapidFireDelay)
            end
        end)
    else
        task.wait(0.02)
        local t = silentAimEnabled and getSilentTarget() or nil
        if t then
            CreateLaserTracer(Camera.CFrame.Position, t.Position)
            local plr = Players:GetPlayerFromCharacter(t.Parent)
            if plr and wasDamagedRecently(plr) then
                CreateHitmarker(t.Position)
                PlayHitSound()
            end
        end
    end
end)

--========================================================--
-- ESP
--========================================================--

local function createESP(player)
    if espCache[player] then return end
    if not Drawing then return end
    local o = {
        Box       = Drawing.new("Square"),
        Name      = Drawing.new("Text"),
        HPBar     = Drawing.new("Square"),
        HPBg      = Drawing.new("Square"),
        Dist      = Drawing.new("Text"),
        Weapon    = Drawing.new("Text"),
    }
    o.Box.Filled = false
    o.Box.Thickness = 1.5
    o.Name.Size = 14; o.Name.Center = true; o.Name.Outline = true
    o.HPBg.Filled = true; o.HPBg.Color = Color3.fromRGB(40,40,40)
    o.HPBar.Filled = true
    o.Dist.Size = 12; o.Dist.Center = true; o.Dist.Outline = true
    o.Weapon.Size = 12; o.Weapon.Center = true; o.Weapon.Outline = true
    for _,d in pairs(o) do d.Visible = false end
    espCache[player] = o
end

local function removeESP(player)
    if espCache[player] then
        for _,d in pairs(espCache[player]) do pcall(function() d:Remove() end) end
        espCache[player] = nil
    end
end

Players.PlayerAdded:Connect(function(p) if p ~= LP then createESP(p) end end)
Players.PlayerRemoving:Connect(removeESP)
for _,p in ipairs(Players:GetPlayers()) do if p ~= LP then createESP(p) end end

local function getEquippedWeapon(char)
    local tool = char:FindFirstChildOfClass("Tool")
    return tool and tool.Name or "Fists"
end

RS.RenderStepped:Connect(function()
    for player, o in pairs(espCache) do
        local char = player.Character
        local visible = espEnabled

        if visible and char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum  = char:FindFirstChildOfClass("Humanoid")

            if root and head and hum and hum.Health > 0 then
                local headPos, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                local legPos, on2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

                if on1 and on2 then
                    local boxH = math.abs(headPos.Y - legPos.Y)
                    local boxW = boxH / 1.6
                    local bx = headPos.X - boxW/2
                    local by = headPos.Y

                    if espBox then
                        o.Box.Size = Vector2.new(boxW, boxH)
                        o.Box.Position = Vector2.new(bx, by)
                        o.Box.Color = espBoxColor
                        o.Box.Visible = true
                    else o.Box.Visible = false end

                    if espName then
                        o.Name.Text = player.Name
                        o.Name.Position = Vector2.new(headPos.X, by - 16)
                        o.Name.Color = espNameColor
                        o.Name.Visible = true
                    else o.Name.Visible = false end

                    if espHealth then
                        local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        local barH = boxH * hp
                        o.HPBg.Size = Vector2.new(4, boxH)
                        o.HPBg.Position = Vector2.new(bx - 6, by)
                        o.HPBg.Visible = true
                        o.HPBar.Size = Vector2.new(4, barH)
                        o.HPBar.Position = Vector2.new(bx - 6, by + (boxH - barH))
                        o.HPBar.Color = Color3.fromHSV(hp * 0.33, 1, 1)
                        o.HPBar.Visible = true
                    else
                        o.HPBg.Visible = false
                        o.HPBar.Visible = false
                    end

                    if espDistance then
                        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        local d = myRoot and math.floor((myRoot.Position - root.Position).Magnitude) or 0
                        o.Dist.Text = d .. " studs"
                        o.Dist.Position = Vector2.new(headPos.X, legPos.Y + 4)
                        o.Dist.Color = espDistColor
                        o.Dist.Visible = true
                    else o.Dist.Visible = false end

                    if espWeapon then
                        o.Weapon.Text = getEquippedWeapon(char)
                        o.Weapon.Position = Vector2.new(headPos.X, legPos.Y + 18)
                        o.Weapon.Color = espWeapColor
                        o.Weapon.Visible = true
                    else o.Weapon.Visible = false end
                else
                    for _,d in pairs(o) do d.Visible = false end
                end
            else
                for _,d in pairs(o) do d.Visible = false end
            end
        else
            for _,d in pairs(o) do d.Visible = false end
        end
    end
end)

--========================================================--
-- MAIN LOOP: FOV / FOG / FULLBRIGHT / MOVEMENT / GUN CHAMS
--========================================================--

local wasInAirBhop = false

RS.Heartbeat:Connect(function(dt)
    if cameraFovEnabled and Camera.FieldOfView ~= cameraFovValue then
        Camera.FieldOfView = cameraFovValue
    end
    if noFogEnabled and Lighting.FogEnd ~= 1e6 then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e5
    end
    if fullbrightEnabled then
        if Lighting.Brightness ~= 3 then Lighting.Brightness = 3 end
        if Lighting.ClockTime ~= 14 then Lighting.ClockTime = 14 end
        if Lighting.GlobalShadows ~= false then Lighting.GlobalShadows = false end
    end

    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if noClipEnabled then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if speedHackEnabled and hum.WalkSpeed ~= speedValue then
        hum.WalkSpeed = speedValue
    end

    if bigJumpEnabled then
        hum.UseJumpPower = true
        if hum.JumpPower ~= bigJumpPower then hum.JumpPower = bigJumpPower end
    end

    if flyEnabled then
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end
        root.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.zero
        hum.PlatformStand = true
    elseif hum.PlatformStand and not freezeEnabled then
        hum.PlatformStand = false
    end

    if freezeEnabled and UIS:IsKeyDown(keybinds.Freeze) then
        if not freezeTargetCF then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
        end
        root.CFrame = freezeTargetCF
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        hum.PlatformStand = true
    elseif freezeTargetCF then
        freezeTargetCF = nil
        hum.PlatformStand = false
    end

    if bhopEnabled then
        local state = hum:GetState()
        local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        if not inAir and wasInAirBhop then
            hum.Jump = true
        end
        wasInAirBhop = inAir
    end

    if gunChamsEnabled then
        for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                for _,p in ipairs(tool:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.Color = gunChamsColor
                        p.Material = Enum.Material.Neon
                    end
                end
            end
        end
    end
end)

--========================================================--
-- JUMP
--========================================================--

UIS.JumpRequest:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if infJumpEnabled then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

--========================================================--
-- FREEZE MOBILE BUTTON
--========================================================--

local freezeBtnGui
local freezeBtn

function CreateFreezeButton()
    if freezeBtnGui then return end
    freezeBtnGui = Instance.new("ScreenGui")
    freezeBtnGui.Name = "AstraFreezeUI"
    freezeBtnGui.ResetOnSpawn = false
    freezeBtnGui.Parent = CoreGui

    freezeBtn = Instance.new("TextButton")
    freezeBtn.Size = UDim2.new(0,110,0,45)
    freezeBtn.Position = UDim2.new(0.1,0,0.4,0)
    freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
    freezeBtn.BorderColor3 = Color3.fromRGB(50,120,255)
    freezeBtn.BorderSizePixel = 2
    freezeBtn.Text = "Freeze Up"
    freezeBtn.TextColor3 = Color3.fromRGB(230,230,230)
    freezeBtn.Font = Enum.Font.SourceSansBold
    freezeBtn.TextSize = 16
    freezeBtn.ZIndex = 99999
    freezeBtn.Parent = freezeBtnGui

    local uc = Instance.new("UICorner",freezeBtn)
    uc.CornerRadius = UDim.new(0,6)

    local dragging, dragInput, dragStart, startPos
    freezeBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = i.Position
            startPos = freezeBtn.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    freezeBtn.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            dragInput = i
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if i == dragInput and dragging then
            local d = i.Position - dragStart
            freezeBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    local pressed = false
    freezeBtn.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pressed = not pressed
        if pressed then
            freezeTargetCF = root.CFrame * CFrame.new(0,50,0)
            freezeBtn.Text = "UNFREEZE"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(180,40,40)
            freezeBtn.BorderColor3 = Color3.fromRGB(255,50,50)
            freezeEnabled = true
        else
            freezeEnabled = false
            freezeTargetCF = nil
            freezeBtn.Text = "Freeze Up"
            freezeBtn.BackgroundColor3 = Color3.fromRGB(30,35,45)
            freezeBtn.BorderColor3 = Color3.fromRGB(50,120,255)
        end
    end)
end

function DestroyFreezeButton()
    if freezeBtnGui then freezeBtnGui:Destroy(); freezeBtnGui = nil; freezeBtn = nil end
    freezeEnabled = false
    freezeTargetCF = nil
end

