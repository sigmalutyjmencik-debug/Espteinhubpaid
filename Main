-- getSilentTarget
local function getSilentTarget()
    local best, bd = nil, FOV_RADIUS
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    for _,p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if TEAM_CHECK and p.Team == LP.Team then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local partName = HIT_PART
        if partName == "Random" then
            local opts = {"Head","Torso","HumanoidRootPart"}
            partName = opts[math.random(1, #opts)]
        end
        local part = char:FindFirstChild(partName) or char:FindFirstChild("Head")
        if not part then continue end

        local pos, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist < bd then bd = dist; best = part end
    end
    return best
end

-- TRACER
local function CreateTracer(from, to)
    if not TRACER then return end
    if (to - from).Magnitude < 1 then return end

    local holder = Instance.new("Part")
    holder.Name = "AstraTracer"
    holder.Size = Vector3.new(0.05,0.05,0.05)
    holder.Transparency = 1
    holder.Anchored = true
    holder.CanCollide = false
    holder.CanTouch = false
    holder.CanQuery = false
    holder.Position = from
    holder.Parent = workspace

    local a0 = Instance.new("Attachment", holder)
    a0.WorldPosition = from
    local a1 = Instance.new("Attachment", holder)
    a1.WorldPosition = to

    local beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = a1
    beam.FaceCamera = true
    beam.LightEmission = 1
    beam.LightInfluence = 0

    if TRACER_TYPE == "Red Laser" then
        beam.Texture = "rbxassetid://6060542021"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 3
        beam.Width0 = 1.2
        beam.Width1 = 1.2
        beam.Color = ColorSequence.new(Color3.fromRGB(255,10,10))
    else
        beam.Texture = "rbxassetid://10259604258"
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.TextureLength = 2
        beam.Width0 = 0.4
        beam.Width1 = 0.4
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150,50,220)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
        })
    end

    beam.Parent = holder
    Debris:AddItem(holder, TRACER_LIFE)
end

-- HIT MARKER
local function CreateHitmarker(worldPosition)
    if not hitMarkerEnabled then return end
    if not Drawing then return end

    local markerId = tostring(math.random(1, 100000))
    local markerData = {
        WorldPosition = worldPosition,
        Size = hitMarkerSize,
        Gap = hitMarkerGap,
        Opacity = 1,
        Lines = {}
    }

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = hitMarkerColor
        line.Thickness = 2.5
        table.insert(markerData.Lines, line)
    end

    ActiveHitmarkers[markerId] = markerData

    task.spawn(function()
        local duration = hitMarkerDuration
        if duration < 0.05 then duration = 0.05 end
        local totalSteps = 20
        local stepTime = duration / totalSteps
        for i = totalSteps, 0, -1 do
            markerData.Opacity = i / totalSteps
            task.wait(stepTime)
        end
        for _, line in ipairs(markerData.Lines) do
            pcall(function() line:Remove() end)
        end
        ActiveHitmarkers[markerId] = nil
    end)
end

RS.RenderStepped:Connect(function()
    for id, marker in pairs(ActiveHitmarkers) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(marker.WorldPosition)
        if onScreen and marker.Opacity > 0 then
            local x, y = screenPos.X, screenPos.Y
            local size = marker.Size
            local gap = marker.Gap

            marker.Lines[1].From = Vector2.new(x - gap, y - gap)
            marker.Lines[1].To = Vector2.new(x - gap - size, y - gap - size)
            marker.Lines[2].From = Vector2.new(x + gap, y - gap)
            marker.Lines[2].To = Vector2.new(x + gap + size, y - gap - size)
            marker.Lines[3].From = Vector2.new(x - gap, y + gap)
            marker.Lines[3].To = Vector2.new(x - gap - size, y + gap + size)
            marker.Lines[4].From = Vector2.new(x + gap, y + gap)
            marker.Lines[4].To = Vector2.new(x + gap + size, y + gap + size)

            for _, line in ipairs(marker.Lines) do
                line.Transparency = marker.Opacity
                line.Visible = true
            end
        else
            for _, line in ipairs(marker.Lines) do
                line.Visible = false
            end
        end
    end
end)

-- SILENT AIM
do
    local blaster = ReplicatedStorage:FindFirstChild("Blaster")
    local castRaysFunc = nil
    if blaster then
        local util = blaster:FindFirstChild("Utility")
        if util then
            local cr = util:FindFirstChild("castRays")
            if cr then
                local ok, f = pcall(require, cr)
                if ok and type(f) == "function" then
                    castRaysFunc = f
                end
            end
        end
    end

    if castRaysFunc and type(hookfunction) == "function" then
        pcall(function()
            local original
            original = hookfunction(castRaysFunc, function(plr, origin, dirs, ...)
                if plr == LP and SILENT_AIM and type(dirs) == "table" then
                    for k in pairs(dirs) do
                        dirs[k] = Vector3.new(0,0,-1)
                    end
                end

                local result = original(plr, origin, dirs, ...)

                if plr == LP then
                    local target = getSilentTarget()
                    if target then
                        if TRACER then
                            pcall(function() CreateTracer(origin, target.Position) end)
                        end

                        if HIT_CHANCE/100 > math.random() then
                            if type(result) == "table" then
                                if result.position then
                                    result.position = target.Position
                                    result.instance = target
                                    if target.Parent then
                                        result.taggedHumanoid = target.Parent:FindFirstChildOfClass("Humanoid")
                                    end
                                elseif result[1] and type(result[1]) == "table" then
                                    result[1].position = target.Position
                                    result[1].instance = target
                                    if target.Parent then
                                        result[1].taggedHumanoid = target.Parent:FindFirstChildOfClass("Humanoid")
                                    end
                                end
                            end

                            pcall(function() CreateHitmarker(target.Position) end)

                            if HIT_SOUND then
                                task.spawn(function()
                                    local s = Instance.new("Sound")
                                    s.SoundId = "rbxassetid://"..HIT_SOUND_ID
                                    s.Volume = HIT_SOUND_VOL
                                    s.Parent = SoundService
                                    s:Play()
                                    task.wait(2)
                                    s:Destroy()
                                end)
                            end

                            return result
                        end
                    end
                end

                return result
            end)
        end)
    end
end

-- JUMP SHOT
if type(getgc) == "function" then
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                local ok, canShoot = pcall(function() return rawget(v, "canShoot") end)
                if ok and type(canShoot) == "function" then
                    local orig = canShoot
                    v.canShoot = function(...)
                        if JUMP_SHOT then return true end
                        return orig(...)
                    end
                end
            end
        end
    end)
end

