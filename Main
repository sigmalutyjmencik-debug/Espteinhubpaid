-- DRAG / RESIZE
local MainDragging, MainDragStart, MainStartPos = false,nil,nil
TitleBar.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        MainDragging = true
        MainDragStart = i.Position
        MainStartPos = Main.Position
    end
end)

local SideDragging, SideDragStart, SideStartPos = false,nil,nil
Side.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        SideDragging = true
        SideDragStart = i.Position
        SideStartPos = Side.Position
    end
end)

local ResizeHandle = Instance.new("TextButton")
ResizeHandle.AnchorPoint = Vector2.new(1,1)
ResizeHandle.Position = UDim2.fromScale(1,1)
ResizeHandle.Size = UDim2.fromOffset(20,20)
ResizeHandle.BackgroundColor3 = BG
ResizeHandle.BorderSizePixel = 0
ResizeHandle.Text = "R"
ResizeHandle.TextColor3 = ACCENT
ResizeHandle.Font = Enum.Font.Code
ResizeHandle.TextSize = 15
ResizeHandle.AutoButtonColor = false
ResizeHandle.ZIndex = 1000
ResizeHandle.Parent = Main

local Resizing, ResizeStart, OrigSize = false,nil,nil
ResizeHandle.InputBegan:Connect(function(i)
    if Locked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        Resizing = true
        ResizeStart = i.Position
        OrigSize = Main.Size
    end
end)

UIS.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    if MainDragging and not Locked then
        local d = i.Position - MainDragStart
        Main.Position = UDim2.fromOffset(MainStartPos.X.Offset + d.X, MainStartPos.Y.Offset + d.Y)
    end
    if SideDragging and not Locked then
        local d = i.Position - SideDragStart
        Side.Position = UDim2.fromOffset(SideStartPos.X.Offset + d.X, SideStartPos.Y.Offset + d.Y)
    end
    if Resizing and not Locked then
        local d = i.Position - ResizeStart
        local w = math.max(650, OrigSize.X.Offset + d.X)
        local h = math.max(400, OrigSize.Y.Offset + d.Y)
        Main.Size = UDim2.fromOffset(w,h)
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        MainDragging = false
        SideDragging = false
        Resizing = false
    end
end)

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if not MainDragging and not Resizing then CenterMain() end
    end)
end

local function IsWhitelisted(plr)
    if not whitelistEnabled then return false end
    return whitelist[plr.Name] == true
end

