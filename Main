local function Checkbox(parent, label, default, callback, yPos)
    local container = Instance.new("Frame")
    container.Position = UDim2.fromOffset(10, yPos)
    container.Size = UDim2.new(1,-20,0,24)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local box = Instance.new("TextButton")
    box.Size = UDim2.fromOffset(18,18)
    box.Position = UDim2.fromOffset(0,3)
    box.BackgroundColor3 = CHECKBG
    box.BorderSizePixel = 0
    box.Text = ""
    box.AutoButtonColor = false
    box.Parent = container
    Stroke(box,1)

    local fill = Instance.new("Frame")
    fill.Position = UDim2.fromOffset(3,3)
    fill.Size = UDim2.fromOffset(12,12)
    fill.BackgroundColor3 = ACCENT_COLOR
    fill.BorderSizePixel = 0
    fill.Visible = default and true or false
    fill.Parent = box
    RegisterAccent(fill,"BackgroundColor3")

    Text(container, label, UDim2.fromOffset(26,0), UDim2.new(1,-26,1,0), 13, WHITE)

    local state = default
    box.MouseButton1Click:Connect(function()
        state = not state
        fill.Visible = state
        if callback then callback(state) end
    end)
    return container
end

local function Slider(parent, label, minV, maxV, default, callback, yPos, suffix)
    suffix = suffix or ""
    local container = Instance.new("Frame")
    container.Position = UDim2.fromOffset(10, yPos)
    container.Size = UDim2.new(1,-20,0,44)
    container.BackgroundTransparency = 1
    container.Parent = parent

    Text(container, label, UDim2.fromOffset(0,0), UDim2.new(1,-60,0,18), 12, WHITE)

    local valLabel = Text(container, tostring(default)..suffix, UDim2.new(1,-60,0,0), UDim2.fromOffset(60,18), 12, ACCENT_COLOR)
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    RegisterBorder(valLabel,"TextColor3")

    local bar = Instance.new("Frame")
    bar.Position = UDim2.fromOffset(0,22)
    bar.Size = UDim2.new(1,0,0,18)
    bar.BackgroundColor3 = BARBG
    bar.BorderSizePixel = 0
    bar.Parent = container
    Stroke(bar,1)

    local ratio = (default - minV) / (maxV - minV)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(ratio,0,1,0)
    fill.BackgroundColor3 = ACCENT_COLOR
    fill.BorderSizePixel = 0
    fill.Parent = bar
    RegisterAccent(fill,"BackgroundColor3")

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromScale(1,1)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 5
    btn.Parent = bar

    local dragging = false
    local function update(input)
        local x = input.Position.X - bar.AbsolutePosition.X
        local r = math.clamp(x / bar.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(r,0,1,0)
        local v = math.floor(minV + (maxV-minV)*r + 0.5)
        valLabel.Text = tostring(v)..suffix
        if callback then callback(v) end
    end

    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            update(i)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return container
end

local function Dropdown(parent, label, options, default, callback, yPos)
    local container = Instance.new("Frame")
    container.Position = UDim2.fromOffset(10, yPos)
    container.Size = UDim2.new(1,-20,0,52)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = false
    container.ZIndex = 50
    container.Parent = parent

    Text(container, label, UDim2.fromOffset(0,0), UDim2.new(1,0,0,18), 12, WHITE)

    local drop = Instance.new("Frame")
    drop.Position = UDim2.fromOffset(0,20)
    drop.Size = UDim2.new(1,0,0,28)
    drop.BackgroundColor3 = DROPBG
    drop.BorderSizePixel = 0
    drop.ZIndex = 51
    drop.Parent = container
    Stroke(drop,1)

    local selText = Text(drop, default or (options[1] or ""), UDim2.fromOffset(8,0), UDim2.new(1,-30,1,0), 12, WHITE)
    selText.ZIndex = 52

    local arrow = Text(drop, "v", UDim2.new(1,-22,0,0), UDim2.fromOffset(20,28), 11, WHITE)
    arrow.TextXAlignment = Enum.TextXAlignment.Center
    arrow.ZIndex = 52

    local click = Instance.new("TextButton")
    click.Size = UDim2.fromScale(1,1)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.ZIndex = 55
    click.Parent = drop

    local menu = Instance.new("Frame")
    menu.Position = UDim2.fromOffset(0,29)
    menu.Size = UDim2.new(1,0,0,#options*24)
    menu.BackgroundColor3 = DROPBG
    menu.BorderSizePixel = 0
    menu.Visible = false
    menu.ZIndex = 100
    menu.Parent = drop
    Stroke(menu,1)

    for i,opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Position = UDim2.fromOffset(0,(i-1)*24)
        ob.Size = UDim2.new(1,0,0,24)
        ob.BackgroundColor3 = DROPBG
        ob.BorderSizePixel = 0
        ob.Text = opt
        ob.TextColor3 = WHITE
        ob.Font = Enum.Font.Code
        ob.TextSize = 12
        ob.TextXAlignment = Enum.TextXAlignment.Left
        ob.AutoButtonColor = false
        ob.ZIndex = 101
        ob.Parent = menu
        Instance.new("UIPadding",ob).PaddingLeft = UDim.new(0,8)

        ob.MouseButton1Click:Connect(function()
            selText.Text = opt
            menu.Visible = false
            if callback then callback(opt) end
        end)
    end

    click.MouseButton1Click:Connect(function()
        menu.Visible = not menu.Visible
    end)
    return container
end

local function KeybindRow(parent, label, default, setter, yPos)
    local container = Instance.new("Frame")
    container.Position = UDim2.fromOffset(10, yPos)
    container.Size = UDim2.new(1,-20,0,24)
    container.BackgroundTransparency = 1
    container.Parent = parent

    Text(container, label, UDim2.fromOffset(0,0), UDim2.new(1,-80,1,0), 13, WHITE)

    local kb = Instance.new("TextButton")
    kb.AnchorPoint = Vector2.new(1,0)
    kb.Position = UDim2.new(1,0,0,3)
    kb.Size = UDim2.fromOffset(70,18)
    kb.BackgroundColor3 = CHECKBG
    kb.BorderSizePixel = 0
    kb.Text = default.Name
    kb.TextColor3 = WHITE
    kb.Font = Enum.Font.Code
    kb.TextSize = 11
    kb.AutoButtonColor = false
    kb.Parent = container
    Stroke(kb,1)

    local waiting = false
    kb.MouseButton1Click:Connect(function()
        waiting = true
        kb.Text = "..."
    end)
    UIS.InputBegan:Connect(function(inp,gpe)
        if waiting and not gpe and inp.UserInputType == Enum.UserInputType.Keyboard then
            setter(inp.KeyCode)
            kb.Text = inp.KeyCode.Name
            waiting = false
        end
    end)
    return container
end

local function ColorRow(parent, label, getColor, setColor, yPos)
    local container = Instance.new("Frame")
    container.Position = UDim2.fromOffset(10, yPos)
    container.Size = UDim2.new(1,-20,0,24)
    container.BackgroundTransparency = 1
    container.Parent = parent

    Text(container, label, UDim2.fromOffset(0,0), UDim2.new(1,-60,1,0), 13, WHITE)

    local btn = Instance.new("TextButton")
    btn.AnchorPoint = Vector2.new(1,0)
    btn.Position = UDim2.new(1,0,0,2)
    btn.Size = UDim2.fromOffset(50,20)
    btn.BackgroundColor3 = getColor()
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = container
    Stroke(btn,1)

    btn.MouseButton1Click:Connect(function()
        OpenPickerForColor(btn, getColor, function(c)
            btn.BackgroundColor3 = c
            setColor(c)
        end)
    end)
    return container
end

